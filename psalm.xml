<?xml version="1.0"?>
<!--
    Complete Psalm configuration: analyzes both src/ and tests/ with full taint analysis.
    Used by CI/CD and `make psalm` for comprehensive static analysis across the entire codebase.
    See psalm-src-only.xml for a faster, src-only variant used for local development.
-->
<psalm
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns="https://getpsalm.org/schema/config"
    xsi:schemaLocation="https://getpsalm.org/schema/config vendor/vimeo/psalm/config.xsd"
    errorLevel="1"
    resolveFromConfigFile="true"
    findUnusedCode="true"
    cacheDirectory="var/cache/psalm"
>
    <projectFiles>
        <directory name="src" />
        <directory name="tests" />
        <ignoreFiles>
            <directory name="vendor" />
            <file name="src/Kernel.php" />
            <file name="tests/bootstrap.php" />
        </ignoreFiles>
    </projectFiles>

    <plugins>
        <pluginClass class="Psalm\SymfonyPsalmPlugin\Plugin">
            <containerXml>var/cache/test/App_KernelTestDebugContainer.xml</containerXml>
        </pluginClass>
        <pluginClass class="Psalm\PhpUnitPlugin\Plugin">
            <containerXml>var/cache/test/App_KernelTestDebugContainer.xml</containerXml>
        </pluginClass>
    </plugins>

    <issueHandlers>
        <PossiblyUnusedMethod>
            <errorLevel type="suppress">
                <directory name="src/Controller" />
                <!--
                    psalm/plugin-phpunit 0.19.7 resolves #[Test] attributes on trait-declared
                    methods using the *consuming* class's import aliases instead of the trait's
                    own, so it never recognizes these as PHPUnit test methods. Fixed upstream in
                    0.20.x, but that requires Psalm 7 (still beta; psalm/plugin-symfony has no
                    stable support for it yet). Remove these once both are upgraded.
                -->
                <file name="tests/src/Unit/Security/AuthenticatorAuthenticateClosedTestTrait.php" />
                <file name="tests/src/Unit/Security/AuthenticatorAuthenticateOpenedTestTrait.php" />
                <file name="tests/src/Unit/Security/AuthenticatorOnAuthentificationTestTrait.php" />
                <file name="tests/src/Unit/Security/AuthenticatorSupportTestTrait.php" />
            </errorLevel>
        </PossiblyUnusedMethod>

        <PossiblyUnusedReturnValue>
            <errorLevel type="suppress">
                <directory name="src/Controller" />
                <file name="src/Security/UserProvider.php" />
            </errorLevel>
        </PossiblyUnusedReturnValue>

        <ClassMustBeFinal>
            <errorLevel type="suppress">
                <directory name="src/Service" />
                <file name="src/Security/UserTokenService.php" />
                <file name="src/Security/UserRefresher.php" />
            </errorLevel>
        </ClassMustBeFinal>
    </issueHandlers>
</psalm>
