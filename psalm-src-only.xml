<?xml version="1.0"?>
<!--
    Psalm configuration for src/ only: analyzes only src/ directory without tests.
    Faster than psalm.xml (no test deserialization overhead) with relaxed unused-code rules (PossiblyUnusedProperty, UnusedClass).
    Useful for quick local feedback during development. For CI/CD and comprehensive analysis, use psalm.xml.
-->
<psalm
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns="https://getpsalm.org/schema/config"
    xsi:schemaLocation="https://getpsalm.org/schema/config vendor/vimeo/psalm/config.xsd"
    errorLevel="1"
    resolveFromConfigFile="true"
    findUnusedCode="true"
    cacheDirectory="var/cache/psalm"
>
    <projectFiles>
        <directory name="src" />
        <ignoreFiles>
            <file name="src/Kernel.php" />
            <directory name="vendor" />
        </ignoreFiles>
    </projectFiles>

    <plugins>
        <pluginClass class="Psalm\SymfonyPsalmPlugin\Plugin">
            <containerXml>var/cache/test/App_KernelTestDebugContainer.xml</containerXml>
        </pluginClass>
        <pluginClass class="Psalm\PhpUnitPlugin\Plugin">
            <containerXml>var/cache/test/App_KernelTestDebugContainer.xml</containerXml>
        </pluginClass>
    </plugins>

    <issueHandlers>
        <PossiblyUnusedMethod>
            <errorLevel type="suppress">
                <directory name="src/Controller" />
                <directory name="src/DTO" />
                <directory name="src/ResponseObject" />
                <referencedMethod name="App\Security\User::getId" />
                <referencedMethod name="App\Security\User::getProfile" />
                <referencedMethod name="App\Security\User::getAccessToken" />
                <!-- Only exercised by tests, which this run does not analyze -->
                <file name="src/Service/Back/GetPokemonsService.php" />
            </errorLevel>
        </PossiblyUnusedMethod>

        <!--
            Psalm 7 reports a private property/method as unused when its only readers are
            public getters that are themselves never called from src/ (they are read by Twig,
            the serializer or the tests).
        -->
        <UnusedProperty>
            <errorLevel type="suppress">
                <directory name="src/DTO" />
                <directory name="src/ResponseObject" />
                <file name="src/Security/User.php" />
            </errorLevel>
        </UnusedProperty>

        <UnusedMethod>
            <errorLevel type="suppress">
                <directory name="src/ResponseObject" />
            </errorLevel>
        </UnusedMethod>

        <PossiblyUnusedProperty>
            <errorLevel type="suppress">
                <directory name="src/DTO" />
                <directory name="src/ResponseObject" />
            </errorLevel>
        </PossiblyUnusedProperty>

        <UnusedClass>
            <errorLevel type="suppress">
                <!-- Only exercised by tests, which this run does not analyze -->
                <file name="src/ResponseObject/Election/ElectionList.php" />
                <file name="src/Service/GetPokemonsListService.php" />
            </errorLevel>
        </UnusedClass>

        <ClassMustBeFinal>
            <errorLevel type="suppress">
                <directory name="src/Service" />
                <file name="src/Security/UserTokenService.php" />
            </errorLevel>
        </ClassMustBeFinal>
    </issueHandlers>
</psalm>
