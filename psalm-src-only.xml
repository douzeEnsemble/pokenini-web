<?xml version="1.0"?>
<psalm
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns="https://getpsalm.org/schema/config"
    xsi:schemaLocation="https://getpsalm.org/schema/config vendor/vimeo/psalm/config.xsd"
    errorLevel="1"
    resolveFromConfigFile="true"
    findUnusedCode="true"
    cacheDirectory="var/cache/psalm"
>
    <projectFiles>
        <directory name="src" />
        <ignoreFiles>
            <file name="src/Kernel.php" />
            <directory name="vendor" />
        </ignoreFiles>
    </projectFiles>

    <plugins>
        <pluginClass class="Psalm\SymfonyPsalmPlugin\Plugin">
            <containerXml>var/cache/test/App_KernelTestDebugContainer.xml</containerXml>
        </pluginClass>
        <pluginClass class="Psalm\PhpUnitPlugin\Plugin">
            <containerXml>var/cache/test/App_KernelTestDebugContainer.xml</containerXml>
        </pluginClass>
    </plugins>

    <issueHandlers>
        <PossiblyUnusedMethod>
            <errorLevel type="suppress">
                <directory name="src/Controller" />
                <directory name="src/DTO" />
                <directory name="src/ResponseObject" />
                <referencedMethod name="App\Security\User::getId" />
                <referencedMethod name="App\Security\User::getProfile" />
            </errorLevel>
        </PossiblyUnusedMethod>
        <PossiblyUnusedProperty>
            <errorLevel type="suppress">
                <directory name="src/DTO" />
            </errorLevel>
        </PossiblyUnusedProperty>

        <ClassMustBeFinal>
            <errorLevel type="suppress">
                <directory name="src/Service" />
                <file name="src/Security/UserTokenService.php" />
            </errorLevel>
        </ClassMustBeFinal>
    </issueHandlers>
</psalm>
