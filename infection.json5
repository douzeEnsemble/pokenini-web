{
    $schema: "vendor/infection/infection/resources/schema.json",
    source: {
        directories: [
            "src",
        ],
    },
    mutators: {
        "@default": true,
        RoundingFamily: {
            ignore: [
                "App\\Helper\\TotalRoundCountHelper::calculate",
            ],
            ignoreSourceCodeByRegex: [
                "\\$this->logger->info.*",
            ]
        },
        CastFloat: {
            ignore: [
                "App\\Helper\\TotalRoundCountHelper::calculate",
            ],
        },
        ArrayItem: {
            ignoreSourceCodeByRegex: [
                "\\$this->logger->info.*",
            ]
        },
        ReturnRemoval: {
            ignore: [
                "App\\Helper\\A1Notation::indexToLetter",
            ],
        },
        NullSafeMethodCall: {
            ignore: [
                "App\\ResponseObject\\Common\\Pokemon::*",
            ],
        },
        "global-ignoreSourceCodeByRegex": [
            "\\$query .= <<<'SUBSQL'.*",
        ],
        "global-ignore": [
            "App\\Controller\\Connect\\FakeController::check",
        ]
    },
    tmpDir: "/app/var/cache/infection",
    timeout: 30,
    testFramework: "phpunit",
    testFrameworkOptions: '--exclude-group="browser-testing"',
    logs: {
        "text": "/app/build/infection/infection_text.log",
        "summary": "/app/build/infection/infection_summary.log",
    },
}
