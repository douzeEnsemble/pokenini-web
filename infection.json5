{
    $schema: "vendor/infection/infection/resources/schema.json",
    source: {
        directories: [
            "src",
        ],
    },
    mutators: {
        "@default": true,
        RoundingFamily: {
            ignore: [
                "App\\Helper\\TotalRoundCountHelper::calculate",
            ],
            ignoreSourceCodeByRegex: [
                "\\$this->logger->info.*",
            ]
        },
        CastFloat: {
            ignore: [
                "App\\Helper\\TotalRoundCountHelper::calculate",
            ],
        },
        ArrayItem: {
            ignoreSourceCodeByRegex: [
                "\\$this->logger->info.*",
            ]
        },
        ReturnRemoval: {
            ignore: [
                "App\\Helper\\A1Notation::indexToLetter",
            ],
        },
        NullSafeMethodCall: {
            ignore: [
                "App\\ResponseObject\\Common\\Pokemon::*",
            ],
        },
        // pairKey() builds a consistent unordered-pair key by always sorting the two
        // slugs into the same string regardless of call-argument order. Both mutants
        // below produce a different-looking but equally consistent ordering (larger
        // slug first instead of smaller), so they're behaviourally equivalent to the
        // original for every possible input — no black-box test on the public
        // getTree() API can ever distinguish them.
        LessThan: {
            ignore: [
                "App\\Service\\GetTrainerDexLinksTreeService::pairKey",
            ],
        },
        Ternary: {
            ignore: [
                "App\\Service\\GetTrainerDexLinksTreeService::pairKey",
            ],
        },
        "global-ignoreSourceCodeByRegex": [
            "\\$query .= <<<'SUBSQL'.*",
        ],
        "global-ignore": [
            "App\\Controller\\Connect\\FakeController::check",
        ]
    },
    tmpDir: "/app/var/cache/infection",
    timeout: 30,
    testFramework: "phpunit",
    testFrameworkOptions: '--exclude-testsuite="Browser Test Suite"',
    logs: {
        "text": "/app/build/infection/infection_text.log",
        "summary": "/app/build/infection/infection_summary.log",
    },
}
