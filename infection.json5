{
    "$schema": "vendor/infection/infection/resources/schema.json",
    "source": {
        "directories": [
            "src"
        ]
    },
    "mutators": {
        "@default": true,
        "global-ignore": [
            "App\\Controller\\ConnectController::googleCheck",
        ]
    },
    "tmpDir": "/var/www/html/var/cache",
    "timeout": 60,
    "testFramework": "phpunit",
    "testFrameworkOptions": '--exclude-group="browser-testing"',
}