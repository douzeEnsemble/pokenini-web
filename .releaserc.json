{
  "branches": ["main"],
  "tagFormat": "v${version}",
  "plugins": [
    [
      "@semantic-release/commit-analyzer",
      {
        "releaseRules": [
          { "type": "build", "scope": "deps", "release": "patch" },
          { "type": "refactor", "release": false }
        ]
      }
    ],
    [
      "@semantic-release/exec",
      {
        "publishCmd": "gh release create v${nextRelease.version} --verify-tag --prerelease --generate-notes --title v${nextRelease.version}"
      }
    ]
  ]
}
