{% set locale = app.request.locale %}

{% extends 'base.html.twig' %}
{% use '_nav.html.twig' %}
{% import 'ColorGame/_macros.html.twig' as colorGame %}

{% block title %}Pokénini {{ 'color_game.title'|trans }}{% endblock title %}

{% block stylesheets %}
  {{ parent() }}

  <link rel="stylesheet" href="{{ asset('css/color-game.css') }}">
{% endblock stylesheets %}

{% block container %}
  {% set dexName = (locale is same as('fr') ? game.dex.frenchName : game.dex.name)|split("\n")|first %}

  {# An abandoned game can still have unanswered rounds: it can not be played anymore #}
  {% set showRound = round is not null and (answer is not null or game.status is same as('in_progress')) %}

  {% if showRound %}
    {% set pokemon = round.pokemon %}
    {% set pokemonName = locale is same as('fr') ? pokemon.frenchName : pokemon.name %}
    {% set formsLabel = locale is same as('fr') ? pokemon.formsFrenchLabel : pokemon.formsLabel %}
    {% include 'Game/_bar.html.twig' with {
      'title': 'color_game.title',
      'dexName': dexName,
      'isShiny': game.isShiny,
      'game': game,
      'round': round,
      'stopPath': answer is null ? path('app_colorgame_dex') : null,
    } only %}

    <div class="row g-4 mt-1 color-game-board">
      <div class="col-xl-4 col-lg-5 col-12">
        <section class="d-flex flex-column gap-3 color-game-panel">
          <div>
            <h3 class="display-5 fw-bold mb-0 pokemon-name">{{ pokemonName }}</h3>
            {% if formsLabel is not empty %}
            <p class="fs-5 text-body-secondary mb-0 pokemon-forms">{{ formsLabel }}</p>
            {% endif %}
          </div>

          <div class="pokemon-image-box align-items-center justify-content-center rounded-3{{ answer is null ? ' pokemon-image-pending d-none d-lg-flex' : ' d-flex border bg-body-tertiary' }}">
            {% if answer is null %}
            <span class="text-body-secondary small text-center px-3">{{ 'color_game.round.image_pending'|trans }}</span>
            {% else %}
            <img
              src="{{ pokemonImageUrl|format(game.isShiny ? 'shiny' : 'regular', pokemon.icon) }}"
              alt="{{ pokemonName }}"
              class="pokemon-image"
              loading="lazy"
            >
            {% endif %}
          </div>
        </section>
      </div>

      <div class="col-xl-8 col-lg-7 col-12">
        {% if answer is null %}
        <div class="d-flex align-items-center mb-3 color-game-status">
          <h4 class="h5 mb-0">{{ 'color_game.round.question'|trans }}</h4>
        </div>
        <form method="post" action="{{ path('app_colorgame_answer', {'gameId': game.id}) }}" class="d-grid gap-2 color-choices">
          <input type="hidden" name="_token" value="{{ csrf_token('color_game') }}">
          <input type="hidden" name="position" value="{{ round.position }}">
          {% for choice in round.choices %}
          <button
            type="submit"
            name="choice"
            value="{{ choice.index }}"
            class="btn btn-outline-secondary d-flex align-items-center gap-3 game-choice color-choice"
            aria-label="{{ 'color_game.round.choice'|trans({'n': loop.index}) }}"
            aria-keyshortcuts="{{ loop.index }}"
            data-key="{{ loop.index }}"
            aria-pressed="false"
          >
            <span class="choice-key" aria-hidden="true">{{ loop.index }}</span>
            {{ colorGame.swatches(choice, locale) }}
            <span class="badge text-bg-primary ms-auto choice-confirm">{{ 'color_game.round.confirm'|trans }}</span>
          </button>
          {% endfor %}
        </form>
        <p class="small text-body-secondary mt-2 mb-0 d-none d-lg-block">{{ 'color_game.round.keys'|trans({'count': round.choices|length}) }}</p>
        {% else %}
        <div class="alert {{ answer.isCorrect ? 'alert-success' : 'alert-danger' }} d-flex flex-wrap align-items-center justify-content-between gap-2 py-2 mb-3 color-game-status answer-box">
          <span class="fs-5 fw-semibold answer-result" role="status">{{ (answer.isCorrect ? 'color_game.answer.correct' : 'color_game.answer.wrong')|trans }}</span>
          <a href="{{ path('app_colorgame_play', {'gameId': game.id}) }}" class="btn btn-primary next-round" aria-keyshortcuts="Enter">
            {{ (game.answeredCount < game.roundCount ? 'color_game.answer.next' : 'color_game.answer.result')|trans }}
          </a>
        </div>

        <div class="d-grid gap-2 color-answers">
          {% for choice in round.choices %}
          {% set isCorrectChoice = choice.index == answer.correctChoice %}
          {% set isChosenChoice = choice.index == answer.chosenChoice %}
          <div class="btn btn-outline-secondary d-flex align-items-center gap-3 color-answer{{ isCorrectChoice ? ' correct-choice' : '' }}{{ isChosenChoice and not isCorrectChoice ? ' chosen-choice' : '' }}">
            {% if isCorrectChoice %}
            <span class="choice-key"><i class="bi bi-check-lg" aria-hidden="true"></i><span class="visually-hidden">{{ 'color_game.answer.right_set'|trans }}</span></span>
            {% elseif isChosenChoice %}
            <span class="choice-key"><i class="bi bi-x-lg" aria-hidden="true"></i><span class="visually-hidden">{{ 'color_game.answer.your_choice'|trans }}</span></span>
            {% else %}
            <span class="choice-key" aria-hidden="true">{{ loop.index }}</span>
            {% endif %}
            {{ colorGame.swatches(choice, locale) }}
          </div>
          {% endfor %}
        </div>
        {% endif %}

        <p class="small text-body-secondary mt-3 mb-1 color-game-warning">
          <i class="bi bi-exclamation-triangle" aria-hidden="true"></i>
          {{ 'color_game.credit.warning'|trans }}
        </p>
        <p class="small text-body-secondary mb-0 color-game-credit">
          {{ 'color_game.credit.text'|trans }}
          <a href="{{ path('app_credits_index') }}">{{ 'color_game.credit.link'|trans }}</a>
        </p>
      </div>
    </div>
  {% else %}
  <div class="row">
    <div class="col-xl-6 col-lg-8 col-12 mx-auto text-center">
      <h1>{{ 'color_game.title'|trans }}</h1>
      <h2>
        <small class="text-body-secondary">{{ dexName }}</small>
        {% if game.isShiny %}
        <span class="badge text-bg-warning game-is-shiny"><i class="bi bi-stars"></i> {{ 'color_game.shiny'|trans }}</span>
        {% endif %}
      </h2>
    </div>
  </div>

  <div class="row mt-3">
    <div class="col-xl-6 col-lg-8 col-12 mx-auto">
      {{ colorGame.progress(game) }}
      <p class="text-center mt-2">{{ colorGame.score(game) }}</p>
    </div>
  </div>

  <div class="row mt-3">
    <div class="col-xl-6 col-lg-8 col-12 mx-auto text-center game-over">
      <h3>{{ ('color_game.over.title.'~game.status)|trans }}</h3>
      <p class="lead">{{ colorGame.score(game) }}</p>
      {{ colorGame.newGameForm(game.dex.slug, 'color_game.over.replay', 'btn-primary new-game') }}
      <a href="{{ path('app_colorgame_dex') }}" class="btn btn-outline-secondary">{{ 'color_game.over.back'|trans }}</a>
    </div>
  </div>
  {% endif %}
{% endblock container %}

{% block foot_javascript %}
  {{ parent() }}

  <script src="{{ asset('js/game.js') }}"></script>
{% endblock foot_javascript %}
