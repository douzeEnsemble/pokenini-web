{% macro action(action, item, icon, updatedItem, updatedAction, updatedState, updateData) %}
    {% set stateColor = {
'ok': 'success',
'ko': 'danger',
} %}

    {% set listGroupItem = 'light' %}
    {% if updatedAction is same as(action) and updatedItem is same as(item) %}
        {% set listGroupItem = stateColor[updatedState] %}
    {% endif %}

    <a
        class="admin-item list-group-item list-group-item-action list-group-item-{{ listGroupItem }}"
        href="{{ path('app_adminaction_'~action, {'name': item}) }}"
    >
        <div class="d-flex w-100 justify-content-between align-items-center">
            {{ ('title.'~action~'.'~item)|trans }}

            <i class="text-primary bi bi-{{ icon }}"></i>
        </div>

        {% if updateData is not empty
            and updatedAction is same as(action)
            and updatedItem is same as(item)
        %}
        <div class="row justify-content-start ms-3">
            <dl class="col-8 row admin-item-report mt-1 mb-0">
                {% for slug, value in updateData %}
                <dt class="col-8">
                    {{ ('admin.'~action~'.'~slug)|trans }}
                </dt>
                <dd class="col-4 text-end mb-0">
                    {{ value|number_format(0, '.', ' ') }}
                </d>
                {% endfor %}
            </dl>
        </div>
        {% endif %}
    </a>

{% endmacro %}