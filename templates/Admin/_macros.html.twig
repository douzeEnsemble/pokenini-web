{% macro action(
    action,
    item,
    icon,
    updatedItem,
    updatedAction,
    updatedState,
    actionLogsData
) %}
    {% set actionItem = action~'_'~item %}

    {% set stateColor = {
'ok': 'success',
'ko': 'danger',
'done': 'light',
'pending': 'info',
} %}

    {% set listGroupItem = 'light' %}

    {% if actionLogsData is not empty
        and actionLogsData[actionItem] is defined
        and actionLogsData[actionItem] is not empty
        and actionLogsData[actionItem]['done_at'] is defined
        and actionLogsData[actionItem]['done_at'] is not empty
    %}
        {% set listGroupItem = stateColor['done'] %}
    {% elseif actionLogsData is not empty
        and actionLogsData[actionItem] is defined
        and actionLogsData[actionItem] is not empty
        and actionLogsData[actionItem]['created_at'] is defined
        and actionLogsData[actionItem]['created_at'] is not empty
    %}
        {% set listGroupItem = stateColor['pending'] %}
    {% endif %}

    {% if updatedAction is same as(action)
        and updatedItem is same as(item)
    %}
        {% set listGroupItem = stateColor[updatedState] %}
    {% endif %}

    <div class="admin-item admin-item-{{ actionItem }} list-group-item list-group-item-action list-group-item-{{ listGroupItem }}">
        <a
            class="admin-item-cta d-flex w-100 justify-content-between align-items-center"
            href="{{ path('app_adminaction_'~action, {'name': item}) }}"
        >
            {{ ('title.'~action~'.'~item)|trans }}

            <i class="text-primary bi bi-{{ icon }}"></i>
        </a>


        {% if actionLogsData is not empty
            and actionLogsData[actionItem] is defined
            and actionLogsData[actionItem] is not empty
        %}
            {% set actionData = actionLogsData[actionItem] %}
        <div class="row justify-content-start ms-3">
            {% if actionData['details'] is defined
                and actionData['details'] is not empty
            %}
            <dl class="col-8 row admin-item-report mt-1 mb-3">
                    {% for slug, value in actionData['details'] %}
                <dt class="col-8">
                    {{ ('admin.'~action~'.'~slug)|trans }}
                </dt>
                <dd class="col-4 text-end mb-0">
                    {{ value|number_format(0, '.', ' ') }}
                </d>
                    {% endfor %}
            </dl>
            {% endif %}
            <div class="col-12 row admin-item-report-date mt-1 mb-0 text-muted">
                {% set date = 'created_at' %}
                {% if actionData['done_at'] is defined
                    and actionData['done_at'] is not empty
                %}
                {% set date = 'done_at' %}
                {% endif %}

                <strong class="col-6">
                    {{ ('admin.action.'~date)|trans }}
                </strong>
                <em class="col-6 text-start mb-0">
                    {{ actionData[date]|date('d/m/Y h:i:s') }}
                </em>
            </div>
        </div>
        {% endif %}
    </div>

{% endmacro %}