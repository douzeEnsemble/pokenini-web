{% set nextPages = {
  'update_data': {'route': 'app_admin_update_availabilities', 'label': 'admin.actions.update_availabilities.title'},
  'update_availabilities': {'route': 'app_admin_calculate_data', 'label': 'admin.actions.calculate_data.title'},
} %}
{% set next = nextPages[page] ?? null %}
{% if steps|length > 1 %}
  <div
    id="run-all"
    class="d-flex align-items-center flex-wrap gap-3 px-4 pt-5 pb-3"
    data-message-running="{{ 'admin.actions.run_all.running'|trans }}"
    data-message-done="{{ 'admin.actions.run_all.done'|trans }}"
{% if not next %}
    data-message-finished="{{ 'admin.actions.run_all.finished'|trans }}"
{% endif %}
    data-message-failed="{{ 'admin.actions.run_all.failed'|trans }}"
  >
    <button
      type="button"
      id="run-all-button"
      class="btn btn-primary"
      data-confirm-message="{{ 'admin.actions.run_all.confirm'|trans({'count': steps|length}) }}"
      data-confirm-dismiss
    >
      <i class="bi bi-play-fill"></i> {{ 'admin.actions.run_all.cta'|trans }}
    </button>
    <span id="run-all-status" class="text-body-secondary" role="status" aria-live="polite"></span>
{% if next %}
    <a
      href="{{ path(next.route, {'run_all': 1}) }}"
      id="run-all-next"
      class="btn btn-success"
      hidden
    >
      {{ 'admin.actions.run_all.next'|trans({'page': next.label|trans}) }} <i class="bi bi-arrow-right"></i>
    </a>
{% endif %}
  </div>
{% else %}
  <div class="pt-5"></div>
{% endif %}
