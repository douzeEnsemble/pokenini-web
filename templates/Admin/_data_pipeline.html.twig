{% import "Admin/_macros.html.twig" as admin %}

<div class="px-4 pt-5">
  <p class="text-body-secondary">{{ 'admin.actions.data_pipeline.intro'|trans }}</p>

  <div
    id="data-pipeline"
    class="d-flex align-items-center flex-wrap gap-3"
    data-message-running="{{ 'admin.actions.data_pipeline.running'|trans }}"
    data-message-done="{{ 'admin.actions.data_pipeline.done'|trans }}"
    data-message-failed="{{ 'admin.actions.data_pipeline.failed'|trans }}"
  >
    <button
      type="button"
      id="data-pipeline-run-all"
      class="btn btn-primary"
      data-confirm-message="{{ 'admin.actions.data_pipeline.run_all_confirm'|trans({'count': steps|length}) }}"
      data-confirm-dismiss
    >
      <i class="bi bi-play-fill"></i> {{ 'admin.actions.data_pipeline.run_all'|trans }}
    </button>
    <span id="data-pipeline-status" class="text-body-secondary" role="status" aria-live="polite"></span>
  </div>
</div>

<div class="row px-4 py-5">
  {% for step in steps %}
    {{ admin.action(step.page, step.type, step.name, step.icon, updatedItem, updatedAction, updatedState, actionLogsData, step.dependsOnTitleKeys) }}
  {% endfor %}
</div>
