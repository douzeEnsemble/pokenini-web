{% set locale = app.request.locale %}

{% set items = app.flashes('item') %}
{% set actions = app.flashes('action') %}
{% set states = app.flashes('state') %}

{% set updatedItem = items[0] is defined ? items[0] : null %}
{% set updatedAction = actions[0] is defined ? actions[0] : null %}
{% set updatedState = states[0] is defined ? states[0] : null %}

{% extends 'base.html.twig' %}
{% use '_nav.html.twig' %}

{% block title %}Pokénini
	{{ 'title.admin'|trans }}
{% endblock %}

{% block stylesheets %}
    {{ parent() }}

    <link rel="stylesheet" href="{{ asset('css/admin.css') }}">
{% endblock stylesheets %}

{% block container %}
<div class="row">
    <div class="col-md-4">

        <h2 class="mt-3">{{ 'title.update_data'|trans }}</h2>

        {% for message in app.flashes('update_error') %}
            <div class="flash-danger alert alert-danger">
                {{ message|trans }}
            </div>
        {% endfor %}

        {% set updateItems = {
            'labels': 'tags-fill',
            'games_and_dexes': 'joystick',
            'pokemons': 'bug-fill',
            'regional_dexes_numbers': 'globe-asia-australia',
            'games_availabilities': 'box-seam',
        } %}
        <div class="list-group">
            {% for item, icon in updateItems %}
                {{ _self.adminItem('update', item, icon, updatedItem, updatedAction, updatedState, responseData) }}
            {% endfor %}
        </div>

    </div>
    <div class="col-md-4">

        <h2 class="mt-3">{{ 'title.calculate_data'|trans }}</h2>

        {% for message in app.flashes('calculate_error') %}
            <div class="flash-danger alert alert-danger">
                {{ message|trans }}
            </div>
        {% endfor %}

        {% set calculateItems = {
            'games_bundles_availabilities': 'box-seam-fill',
            'dexes_availabilities': 'list-check',
        } %}
        <div class="list-group">
            {% for item, icon in calculateItems %}
                {{ _self.adminItem('calculate', item, icon, updatedItem, updatedAction, updatedState, responseData) }}
            {% endfor %}
        </div>

    </div>
    <div class="col-md-4">

        <h2 class="mt-3">{{ 'title.invalidate_data'|trans }}</h2>

        {% for message in app.flashes('invalidate_error') %}
            <div class="flash-danger alert alert-danger">
                {{ message|trans }}
            </div>
        {% endfor %}

        {% set invalidateItems = {
            'catch_states': 'tag',
            'dexes': 'journals',
            'albums': 'journal-album',
        } %}
        <div class="list-group">
            {% for item, icon in invalidateItems %}
                {{ _self.adminItem('invalidate', item, icon, updatedItem, updatedAction, updatedState, responseData) }}
            {% endfor %}
        </div>
    </div>
{% endblock %}

{% macro adminItem(action, item, icon, updatedItem, updatedAction, updatedState, updateData) %}
    {% set stateColor = {
'ok': 'success',
'ko': 'danger',
} %}

    {% set listGroupItem = 'light' %}
    {% if updatedAction is same as(action) and updatedItem is same as(item) %}
        {% set listGroupItem = stateColor[updatedState] %}
    {% endif %}

    <a class="admin-item list-group-item list-group-item-action list-group-item-{{ listGroupItem }}" href="{{ path('app_adminaction_'~action, {'name': item}) }}">
        <div class="d-flex w-100 justify-content-between align-items-center">
            {{ ('title.'~action~'.'~item)|trans }}

            <i class="text-primary bi bi-{{ icon }}"></i>
        </div>

        {% if updateData is not empty
            and updatedAction is same as(action)
            and updatedItem is same as(item)
        %}
        <div class="row justify-content-start ms-3">
            <dl class="col-8 row admin-item-report mt-1 mb-0">
                {% for slug, value in updateData %}
                <dt class="col-8">
                    {{ ('admin.'~action~'.'~slug)|trans }}
                </dt>
                <dd class="col-4 text-end mb-0">
                    {{ value|number_format(0, '.', ' ') }}
                </d>
                {% endfor %}
            </dl>
        </div>
        {% endif %}
    </a>

{% endmacro %}
