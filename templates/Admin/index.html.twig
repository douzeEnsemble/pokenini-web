{% set locale = app.request.locale %}

{% extends 'base.html.twig' %}
{% use '_nav.html.twig' %}

{% block title %}Pokénini
	{{ 'title.admin'|trans }}
{% endblock %}

{% block container %}
<div class="row">
    <div class="col-md-4 mx-auto text-center">

        <h2 class="mt-3">{{ 'title.update_data'|trans }}</h2>

        {% for message in app.flashes('update_error') %}
            <div class="flash-danger alert alert-danger">
                {{ message|trans }}
            </div>
        {% endfor %}

        {% set updateItems = {
            'labels': 'tag',
            'games_and_dexes': 'joystick',
            'pokemons': 'bug-fill',
            'regional_dex_number': 'globe-asia-australia',
            'game_availability': 'box-seam',
        } %}
        <div class="list-group">
            {% for item, icon in updateItems %}
                {{ _self.adminItem('update', item, icon) }}
            {% endfor %}
        </div>

        <h2 class="mt-3">{{ 'title.calculate_data'|trans }}</h2>

        {% for message in app.flashes('calculate_error') %}
            <div class="flash-danger alert alert-danger">
                {{ message|trans }}
            </div>
        {% endfor %}

        {% set calculateItems = {
            'game_bundle_availability': 'box-seam-fill',
            'dex_availability': 'list-check',
        } %}
        <div class="list-group">
            {% for item, icon in calculateItems %}
                {{ _self.adminItem('calculate', item, icon) }}
            {% endfor %}
        </div>
    </div>
{% endblock %}

{% macro adminItem(type, item, icon) %}
    {% set updatedItem = app.request.get('item') %}
    {% set state = app.request.get('state') %}
    {% set stateColor = {
'ok': 'success',
'ko': 'danger',
} %}

    {% set listGroupItem = 'light' %}
    {% if updatedItem is same as(item) %}
        {% set listGroupItem = stateColor[state] %}
    {% endif %}

    <a class="admin-item list-group-item list-group-item-action list-group-item-{{ listGroupItem }} d-flex justify-content-between align-items-center" href="{{ path('app_adminupdate_'~type, {'name': item}) }}">
        {{ ('title.'~type~'.'~item)|trans }}
        <i class="text-primary bi bi-{{ icon }}"></i>
    </a>
{% endmacro %}
