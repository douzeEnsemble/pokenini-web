{% set locale = app.request.locale %}

{% extends 'base.html.twig' %}
{% use '_nav.html.twig' %}

{% block title %}Pokénini {{ 'title.admin'|trans }}{% endblock %}

{% block container %}
<div class="row">
    <div class="col-md-8 mx-auto text-center">
        {# read and display all flash messages #}
        {% for label, messages in app.flashes %}
            {% for message in messages %}
            <div class="flash-{{ label }} alert alert-{{ label }}">
                {{ message|trans }}
            </div>
            {% endfor %}
        {% endfor %}

        <h2>{{ 'title.update_data'|trans }}</h2>
        <ul class="nav flex-column">
            <li class="nav-item admin-item">
                <a
                    href="{{ path('app_adminupdate_update', {'name': 'labels'}) }}"
                    class="nav-link"
                >
                    <i class="bi bi-tag"></i>
                    {{ 'title.update.labels'|trans }}
                </a>
            </li>
            <li class="nav-item admin-item">
                <a
                    href="{{ path('app_adminupdate_update', {'name': 'games_and_dexes'}) }}"
                    class="nav-link"
                >
                    <i class="bi bi-joystick"></i>
                    {{ 'title.update.games_and_dexes'|trans }}
                </a>
            </li>
            <li class="nav-item admin-item">
                <a
                    href="{{ path('app_adminupdate_update', {'name': 'pokemons'}) }}"
                    class="nav-link"
                >
                    <i class="bi bi-bug-fill"></i>
                    {{ 'title.update.pokemons'|trans }}
                </a>
            </li>
            <li class="nav-item admin-item">
                <a
                    href="{{ path('app_adminupdate_update', {'name': 'game_availability'}) }}"
                    class="nav-link"
                >
                    <i class="bi bi-box-seam"></i>
                    {{ 'title.update.game_availability'|trans }}
                </a>
            </li>
            <li class="nav-item admin-item">
                <a
                    href="{{ path('app_adminupdate_calculate', {'name': 'game_bundle_availability'}) }}"
                    class="nav-link"
                >
                    <i class="bi bi-box-seam-fill"></i>
                    {{ 'title.calculate.game_bundle_availability'|trans }}
                </a>
            </li>
            <li class="nav-item admin-item">
                <a
                    href="{{ path('app_adminupdate_calculate', {'name': 'dex_availability'}) }}"
                    class="nav-link"
                >
                    <i class="bi bi-list-check"></i>
                    {{ 'title.calculate.dex_availability'|trans }}
                </a>
            </li>
        </ul>
    </div>
</div>
{% endblock %}
