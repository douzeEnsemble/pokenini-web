{% import "Admin/_macros.html.twig" as admin %}

<div class="row px-4 pt-5">
  <p class="text-body-secondary small">{{ 'admin.actions.trigger_pipeline.help'|trans }}</p>
</div>

<div class="row px-4 pb-4 admin-pipeline-group" id="pipeline_group_update_images">
  {{ admin.action('trigger_pipeline', 'trigger', 'update_images', 'images', updatedItem, updatedAction, updatedState, actionLogsData) }}
  {% include 'Admin/_pipeline_status.html.twig' %}
</div>

<div class="row px-4 pb-4 admin-pipeline-group" id="pipeline_group_update_banners">
  {{ admin.action('trigger_pipeline', 'trigger', 'update_banners', 'flag', updatedItem, updatedAction, updatedState, actionLogsData) }}
  {% include 'Admin/_banner_pipeline_status.html.twig' %}
</div>
