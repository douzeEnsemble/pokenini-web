{% set appStatusCode = appStatusCode ?? 'unknown' %}
{% extends 'base.html.twig' %}
{% use '_nav.html.twig' %}

{% block title %}Pokénini {{ ('title.error.'~appStatusCode)|trans }}{% endblock title %}

{% block container %}
    <div class="d-flex flex-column align-items-center justify-content-center text-center" style="min-height: 50vh;">
        <img src="/img/logo/logo.png" alt="" width="96" height="96" class="mb-4" loading="lazy">

        <h1>{{ ('title.error.'~appStatusCode)|trans }}</h1>

        <p>
            {{ ('error.'~appStatusCode~'.text')|trans|htmlNl2br }}
        </p>
        <a href="{{ path('app_home_index') }}">
            {{ 'nav.home'|trans }}
        </a>
    </div>
{% endblock %}
