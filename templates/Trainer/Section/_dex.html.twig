{% import "common/_progress_bar_macros.html.twig" as progressBar %}
{% import "common/_dex_category_macros.html.twig" as dexCategory %}
{% set attributes = [
    'is_private',
    'is_on_home',
    'is_on_hub',
] %}
{% set attributesIcons = {
    'is_private': 'incognito',
    'is_on_home': 'house-check',
    'is_on_hub': 'pin-angle',
} %}
{# Only a few albums go on the hub: once they are chosen, the others can't be added (see public/js/trainer_dex.js) #}
{% set maxOnHub = 3 %}
{% set onHubFull = trainerDex|filter(dex => dex.flags.isOnHub)|length >= maxOnHub %}
<h2>{{ ('trainer.dex.title')|trans }}</h2>
<div class="card mb-5" data-max-on-hub="{{ maxOnHub }}">
  <div class="card-header row">
    {{ include('Trainer/Section/_dex_filters.html.twig') }}
  </div>
  <div class="card-body">
    {% set dexGroups = trainerDex|dex_category_groups %}
    {% set showDexCategories = dexGroups|filter(group => group.category is not null) is not empty %}
    {% if showDexCategories %}
    {{ dexCategory.summary(dexGroups) }}
    {% endif %}
    {% for group in dexGroups %}
    {% if showDexCategories %}
    {{ dexCategory.heading(group, 'dex_category.dex_count', 'h3') }}
    {% endif %}
    <div class="row{{ showDexCategories ? ' collapse show' }}"{% if showDexCategories %} {{ dexCategory.listAttributes(group) }}{% endif %}>
      {% for dex in group.items %}
        {% set canEdit = dex.flags.isPremium == false or is_granted('ROLE_COLLECTOR') %}
        {% set flagMap = {'is_private': dex.flags.isPrivate, 'is_on_home': dex.flags.isOnHome, 'is_on_hub': dex.flags.isOnHub} %}
        <div class="col-12 col-sm-6 col-md-4 col-lg-3 mb-4 mb-sm-3 trainer-dex-item border rounded border-opacity-50 position-relative" id="trainer-dex-{{ dex.settings.slug }}">
          <div class="position-absolute top-0 end-0 me-2">
            {% if dex.flags.isShiny %}
              <span class="dex_is_shiny badge text-bg-warning" role="img" aria-label="{{ ('trainer.dex.attributes.is_shiny.label')|trans }}" tabindex="0" data-bs-toggle="tooltip" data-bs-trigger="hover focus" data-bs-title="{{ ('trainer.dex.attributes.is_shiny.label')|trans }}">
                <i class="bi bi-stars" aria-hidden="true"></i>
              </span>
            {% endif %}
            {% if dex.flags.isPremium %}
              <span class="dex_is_premium badge text-bg-success" role="img" aria-label="{{ ('trainer.dex.attributes.is_premium.label')|trans }}" tabindex="0" data-bs-toggle="tooltip" data-bs-trigger="hover focus" data-bs-title="{{ ('trainer.dex.attributes.is_premium.label')|trans }}">
                <i class="bi bi-patch-plus" aria-hidden="true"></i>
              </span>
            {% endif %}
            {% if not dex.flags.isReleased %}
              <span class="dex_not_is_released badge text-bg-danger" role="img" aria-label="{{ ('trainer.dex.attributes.not.is_released.label')|trans }}" tabindex="0" data-bs-toggle="tooltip" data-bs-trigger="hover focus" data-bs-title="{{ ('trainer.dex.attributes.not.is_released.label')|trans }}">
                <i class="bi bi-lock" aria-hidden="true"></i>
              </span>
            {% endif %}
            {% if dex.flags.isCustom %}
              <span class="dex_is_custom badge text-bg-info" role="img" aria-label="{{ ('trainer.dex.attributes.is_custom.label')|trans }}" tabindex="0" data-bs-toggle="tooltip" data-bs-trigger="hover focus" data-bs-title="{{ ('trainer.dex.attributes.is_custom.label')|trans }}">
                <i class="bi bi-person" aria-hidden="true"></i>
              </span>
            {% endif %}
          </div>

          {% set bannerUrl = dexBannerUrl|format(dex.dex.slug) %}
          {% set defaultBannerUrl = dexBannerUrl|format('default') %}
          <img src="{{ bannerUrl }}" class="img-fluid img-loader" alt="" width="578" height="325" loading="lazy" onload="this.classList.add('is-loaded')" onerror="this.onerror=null;this.src='{{ defaultBannerUrl }}';">

          <div class="mt-3 mb-3">
            <a class="float-end btn btn-light btn-sm" href="{{ path('app_albumindex_index', {'dexSlug': dex.settings.slug}) }}" title="{{ 'trainer.dex.see'|trans }}">
              <i class="bi bi-eye-fill"></i>
              {{ 'trainer.dex.see'|trans }}
            </a>
            <p class="h5">
              {{ dex.settings.names|localized }}
            </p>
          </div>

          {% if dex.report is not null %}
          {{ progressBar.catchStateBar(dex.report) }}
          {% endif %}

          <hr>
          <form data-dex="{{ dex.settings.slug }}">
            {% for attribute in attributes %}
              <div class="form-check form-switch">
                {% set isHubFull = attribute is same as('is_on_hub') and onHubFull and not flagMap[attribute] %}
                <input class="form-check-input" type="checkbox" role="switch" name="{{ dex.settings.slug }}-{{ attribute }}" id="{{ dex.settings.slug }}-{{ attribute }}" {{ flagMap[attribute] ? 'checked' : '' }} {{ canEdit and not isHubFull ? '' : 'disabled' }}{% if not canEdit %} data-locked{% endif %}>
                <label class="form-check-label" for="{{ dex.settings.slug }}-{{ attribute }}">
                  <i class="bi bi-{{ attributesIcons[attribute] }}"></i>
                  {{ ('trainer.dex.attributes.'~attribute~'.label')|trans }}
                </label>
                <p class="form-text">
                  {{ ('trainer.dex.attributes.'~attribute~'.help')|trans }}
                </p>
              </div>
            {% endfor %}
          </form>
        </div>
      {% endfor %}
    </div>
    {% endfor %}

    <div class="row">
      <div class="toast-container position-fixed bottom-0 mb-5 end-0 p-3">
        {{ include('common/_too_many_on_hub_toast.html.twig') }}
        {% for dex in trainerDex %}
          {% set dexName = dex.settings.names|localized %}
          <div id="successToast-{{ dex.settings.slug }}" class="toast text-bg-success" role="alert" aria-live="assertive" aria-atomic="true">
            <div class="d-flex">
              <div class="toast-body">
                {{ 'trainer.dex.update.success.prefix'|trans }}
                <strong>{{ 'trainer.dex.update.success.radical'|trans({'dexName': dexName}) }}</strong>
                {{ 'trainer.dex.update.success.suffix'|trans }}
              </div>
              <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="{{ 'a11y.close'|trans }}"></button>
            </div>
          </div>

          <div id="errorToast-{{ dex.settings.slug }}" class="toast text-bg-danger" role="alert" aria-live="assertive" aria-atomic="true">
            <div class="d-flex">
              <div class="toast-body">
                {{ 'trainer.dex.update.error.prefix'|trans }}
                <strong>{{ 'trainer.dex.update.error.radical'|trans({'dexName': dexName}) }}</strong>
                {{ 'trainer.dex.update.error.suffix'|trans }}
              </div>
              <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="{{ 'a11y.close'|trans }}"></button>
            </div>
          </div>
        {% endfor %}
      </div>
    </div>
  </div>
</div>
