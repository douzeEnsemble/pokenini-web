{% set locale = app.request.locale %}

{% extends 'base.html.twig' %}
{% use '_nav.html.twig' %}
{% import "AlbumDexList/_macro.html.twig" as list %}

{% block title %}Pokénini {{ 'election_dex.title'|trans }}{% endblock title %}

{% block stylesheets %}
  {{ parent() }}

  <link rel="stylesheet" href="{{ asset('css/election_dex.css') }}">
  <link rel="stylesheet" href="{{ asset('css/dex-list.css') }}">
{% endblock stylesheets %}

{% block container %}
  <div class="mx-auto">
    <div class="row">
      <div class="col-xl-6 col-lg-8 col-12 mx-auto text-center row">
        <h1>
          {{ 'election_dex.title'|trans }}
        </h1>
        <h2>
          <small class="text-body-secondary">
            {{ 'election_dex.subtitle'|trans }}
          </small>
        </h2>
      </div>
    </div>

    {{ list.listElections(dex, locale, null) }}
  </div>
  {% block footer %}
    {{ include('_footer.html.twig') }}
  {% endblock footer %}
{% endblock container %}
