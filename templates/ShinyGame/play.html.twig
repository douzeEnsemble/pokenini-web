{% set locale = app.request.locale %}

{% extends 'base.html.twig' %}
{% use '_nav.html.twig' %}
{% import 'ColorGame/_macros.html.twig' as colorGame %}
{% import 'ShinyGame/_macros.html.twig' as shinyGame %}
{% import 'Game/_macros.html.twig' as gameMacros %}

{% block title %}Pokénini {{ 'shiny_game.title'|trans }}{% endblock title %}

{% block stylesheets %}
  {{ parent() }}

  <link rel="stylesheet" href="{{ asset('css/color-game.css') }}">
  <link rel="stylesheet" href="{{ asset('css/shiny-game.css') }}">
{% endblock stylesheets %}

{% block container %}
  {% set dexName = (locale is same as('fr') ? game.dex.frenchName : game.dex.name)|split("\n")|first %}

  {# An abandoned game can still have unanswered rounds: it can not be played anymore #}
  {% set showRound = round is not null and (answer is not null or game.status is same as('in_progress')) %}

  {% if showRound %}
    {% set pokemon = round.pokemon %}
    {% set pokemonName = locale is same as('fr') ? pokemon.frenchName : pokemon.name %}
    {% set formsLabel = locale is same as('fr') ? pokemon.formsFrenchLabel : pokemon.formsLabel %}
    {% include 'Game/_bar.html.twig' with {
      'title': 'shiny_game.title',
      'dexName': dexName,
      'isShiny': false,
      'game': game,
      'round': round,
      'stopPath': path('app_shinygame_dex'),
    } only %}

    <div class="row g-3 g-lg-4 mt-0 mt-lg-1 shiny-game-board">
      <div class="col-xl-4 col-lg-5 col-12">
        <section class="d-flex flex-column gap-3">
          <div>
            <h3 class="display-5 fw-bold mb-0 pokemon-name">{{ pokemonName }}</h3>
            {% if formsLabel is not empty %}
            <p class="fs-5 text-body-secondary mb-0 pokemon-forms">{{ formsLabel }}</p>
            {% endif %}
          </div>

          <div class="d-flex align-items-center justify-content-center rounded-3 border bg-body-tertiary shiny-game-image-box">
            {% if answer is null %}
            {# The image is served by the web, so its URL does not tell which version it is #}
            <img
              src="{{ path('app_shinygame_image', {'gameId': game.id, 'position': round.position}) }}"
              alt="{{ 'shiny_game.round.image'|trans }}"
              class="shiny-game-image round-image img-loader"
              width="256"
              height="256"
              onload="this.classList.add('is-loaded')"
              onerror="this.classList.add('is-loaded')"
            >
            {% else %}
            <img
              src="{{ pokemonImageUrl|format(answer.isShiny ? 'shiny' : 'regular', pokemon.icon) }}"
              alt="{{ pokemonName }}"
              class="shiny-game-image shown-image img-loader"
              width="256"
              height="256"
              onload="this.classList.add('is-loaded')"
              onerror="this.classList.add('is-loaded')"
            >
            {% endif %}
          </div>
        </section>
      </div>

      <div class="col-xl-8 col-lg-7 col-12">
        {% if answer is null %}
        <div class="d-flex align-items-center mb-3 color-game-status">
          <h4 class="h5 mb-0">{{ 'shiny_game.round.question'|trans }}</h4>
        </div>

        <form method="post" action="{{ path('app_shinygame_answer', {'gameId': game.id}) }}" class="row g-3 shiny-choices">
          <input type="hidden" name="_token" value="{{ csrf_token('shiny_game') }}">
          <input type="hidden" name="position" value="{{ round.position }}">
          {% for isShiny in [false, true] %}
          <div class="col-6">
            <button
              type="submit"
              name="is_shiny"
              value="{{ isShiny ? '1' : '0' }}"
              class="btn btn-outline-secondary w-100 h-100 d-flex flex-column align-items-center gap-2 shiny-card game-choice shiny-choice"
              aria-keyshortcuts="{{ loop.index }}"
              data-key="{{ loop.index }}"
              aria-pressed="false"
            >
              <span class="d-flex align-items-center justify-content-center gap-2 fs-5 fw-semibold shiny-card-label">
                <span class="choice-key" aria-hidden="true">{{ loop.index }}</span>
                {% if isShiny %}<i class="bi bi-stars" aria-hidden="true"></i>{% endif %}
                <span class="version-name">{{ (isShiny ? 'shiny_game.round.shiny' : 'shiny_game.round.regular')|trans }}</span>
              </span>
              <span class="d-none d-lg-flex align-items-center justify-content-center w-100 rounded-3 pokemon-image-pending shiny-version-box">
                <i class="bi bi-question-lg fs-1 text-body-secondary" aria-hidden="true"></i>
              </span>
              <span class="d-flex align-items-center justify-content-center game-choice-caption">
                <span class="badge text-bg-primary choice-confirm">{{ 'color_game.round.confirm'|trans }}</span>
              </span>
            </button>
          </div>
          {% endfor %}
        </form>
        <p class="small text-body-secondary mt-2 mb-0 d-none d-lg-block">{{ 'shiny_game.round.keys'|trans }}</p>
        {% else %}
        <div class="alert {{ answer.isCorrect ? 'alert-success' : 'alert-danger' }} d-flex flex-wrap align-items-center justify-content-between gap-2 py-2 mb-3 color-game-status answer-box">
          <span class="fs-5 fw-semibold answer-result" role="status">{{ (answer.isCorrect ? 'shiny_game.answer.correct' : 'shiny_game.answer.wrong')|trans }}</span>
          <a href="{{ path('app_shinygame_play', {'gameId': game.id}) }}" class="btn btn-primary next-round" aria-keyshortcuts="Enter">
            {{ (game.answeredCount < game.roundCount ? 'color_game.answer.next' : 'color_game.answer.result')|trans }}
          </a>
        </div>

        <div class="row g-3 shiny-answers">
          {% for isShiny in [false, true] %}
          {% set isShown = isShiny == answer.isShiny %}
          {% set isChosen = isShiny == answer.isChosenShiny %}
          <div class="col-6">
            <figure class="h-100 m-0 border rounded-3 d-flex flex-column align-items-center gap-2 shiny-card shiny-version{{ isShown ? ' shown-version' : '' }}{{ isChosen and not isShown ? ' chosen-version' : '' }}">
              <span class="d-flex align-items-center justify-content-center gap-2 fs-5 fw-semibold shiny-card-label">
                <span class="choice-key" aria-hidden="true">{{ loop.index }}</span>
                {% if isShiny %}<i class="bi bi-stars" aria-hidden="true"></i>{% endif %}
                <span class="version-name">{{ (isShiny ? 'shiny_game.round.shiny' : 'shiny_game.round.regular')|trans }}</span>
              </span>
              <span class="d-flex align-items-center justify-content-center w-100 shiny-version-box">
                <img
                  src="{{ pokemonImageUrl|format(isShiny ? 'shiny' : 'regular', pokemon.icon) }}"
                  alt="{{ pokemonName }} {{ (isShiny ? 'shiny_game.round.shiny' : 'shiny_game.round.regular')|trans }}"
                  class="shiny-game-image img-loader"
                  width="256"
                  height="256"
                  onload="this.classList.add('is-loaded')"
                  onerror="this.classList.add('is-loaded')"
                >
              </span>
              <figcaption class="d-flex align-items-center justify-content-center game-choice-caption">
                {% if isShown %}
                <span class="badge text-bg-success version-label"><i class="bi bi-check-lg" aria-hidden="true"></i> {{ 'shiny_game.answer.shown'|trans }}</span>
                {% elseif isChosen %}
                <span class="badge text-bg-danger version-label"><i class="bi bi-x-lg" aria-hidden="true"></i> {{ 'shiny_game.answer.your_choice'|trans }}</span>
                {% endif %}
              </figcaption>
            </figure>
          </div>
          {% endfor %}
        </div>
        {% endif %}
      </div>
    </div>
  {% else %}
  <div class="row">
    <div class="col-xl-6 col-lg-8 col-12 mx-auto text-center">
      <h1>{{ 'shiny_game.title'|trans }}</h1>
      <h2>
        <small class="text-body-secondary">{{ dexName }}</small>
      </h2>
    </div>
  </div>

  <div class="row mt-3">
    <div class="col-xl-6 col-lg-8 col-12 mx-auto">
      {{ colorGame.progress(game) }}
      <p class="text-center mt-2">{{ colorGame.score(game) }}</p>
    </div>
  </div>

  <div class="row mt-3">
    <div class="col-xl-6 col-lg-8 col-12 mx-auto text-center game-over">
      <h3>{{ ('color_game.over.title.'~game.status)|trans }}</h3>
      <p class="lead">{{ colorGame.score(game) }}</p>
      {{ shinyGame.newGameForm(game.dex.slug, 'color_game.over.replay', 'btn-primary new-game') }}
      <a href="{{ path('app_shinygame_dex') }}" class="btn btn-outline-secondary">{{ 'color_game.over.back'|trans }}</a>
      {% if game.answeredCount > 0 %}
      <a href="{{ path('app_shinygame_rounds', {'gameId': game.id}) }}" class="btn btn-outline-primary game-review">{{ 'game.review.over'|trans }}</a>
      {{ gameMacros.sharePanel(game, 'shiny_game.title', 'app_shinygame_dex', false) }}
      {% endif %}
    </div>
  </div>
  {{ gameMacros.shareToasts() }}
  {% endif %}
{% endblock container %}

{% block foot_javascript %}
  {{ parent() }}

  <script src="{{ asset('js/game.js') }}"></script>
  <script src="{{ asset('js/game-share.js') }}"></script>
{% endblock foot_javascript %}
