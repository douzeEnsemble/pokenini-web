{#
  Starts a game on a dex, after choosing the number of rounds: 10, 20, 50, the whole dex, or another number.
  playableCount is the number of Pokémon of the dex, when it is known: the counts it does not reach are not offered.
#}
{% macro newGameForm(route, csrfId, dexSlug, label, buttonClass, playableCount = null) %}
{% set roundCounts = [10, 20, 50]|filter(count => playableCount is null or count < playableCount) %}
{% if roundCounts is empty %}
<form method="post" action="{{ path(route) }}" class="d-inline">
  <input type="hidden" name="_token" value="{{ csrf_token(csrfId) }}">
  <input type="hidden" name="dex_slug" value="{{ dexSlug }}">
  <button type="submit" class="btn {{ buttonClass }}">{{ label|trans }}</button>
</form>
{% else %}
<div class="dropdown d-inline-block new-game-dropdown">
  <button type="button" class="btn {{ buttonClass }} dropdown-toggle" data-bs-toggle="dropdown" data-bs-auto-close="outside" aria-expanded="false">{{ label|trans }}</button>
  <div class="dropdown-menu round-count-menu">
    <form method="post" action="{{ path(route) }}" class="round-count-presets">
      <input type="hidden" name="_token" value="{{ csrf_token(csrfId) }}">
      <input type="hidden" name="dex_slug" value="{{ dexSlug }}">
      <h6 class="dropdown-header">{{ 'color_game.rounds.title'|trans }}</h6>
      {% for count in roundCounts %}
      <button type="submit" name="round_count" value="{{ count }}" class="dropdown-item round-count">{{ 'color_game.rounds.count'|trans({'count': count}) }}</button>
      {% endfor %}
      <button type="submit" name="round_count" value="" class="dropdown-item round-count-all">
        {{ playableCount is null ? 'color_game.rounds.all'|trans : 'color_game.rounds.all_count'|trans({'count': playableCount}) }}
      </button>
    </form>
    <div class="dropdown-divider"></div>
    <form method="post" action="{{ path(route) }}" class="px-3 py-1 round-count-custom">
      <input type="hidden" name="_token" value="{{ csrf_token(csrfId) }}">
      <input type="hidden" name="dex_slug" value="{{ dexSlug }}">
      <div class="input-group input-group-sm">
        <input
          type="number"
          name="round_count"
          min="1"
          {% if playableCount is not null %}max="{{ playableCount }}"{% endif %}
          required
          class="form-control"
          placeholder="{{ 'color_game.rounds.custom'|trans }}"
          aria-label="{{ 'color_game.rounds.custom'|trans }}"
        >
        <button type="submit" class="btn btn-primary">{{ 'color_game.rounds.custom_submit'|trans }}</button>
      </div>
    </form>
  </div>
</div>
{% endif %}
{% endmacro %}

{#
  Shares the result of a game as a text: the game, the dex, the score, a grid of the answered rounds and a link to the game.
  The player sees a preview and switches between the text with the grid (see GameExtension) and the score alone.
  On a phone it opens the share menu of the device, elsewhere it copies the text (see public/js/game-share.js and the toasts of shareToasts).
#}
{% macro sharePanel(game, titleKey, dexRoute, isShiny = false, showHeading = true) %}
{% set dexName = (app.request.locale is same as('fr') ? game.dex.frenchName : game.dex.name)|split("\n")|first %}
{% set percent = game.answeredCount > 0 ? (game.correctCount * 100 / game.answeredCount)|round : 0 %}
{% set header = 'Pokénini · ' ~ titleKey|trans ~ (isShiny ? ' ✨' : '') ~ "\n" ~ dexName ~ ' · ' ~ 'game.share.score'|trans({'correct': game.correctCount, 'answered': game.answeredCount, 'percent': percent}) %}
{% set link = url(dexRoute) %}
{% set grid = game_results_grid(game.results) %}
{% set scoreText = header ~ "\n" ~ link %}
{% set gridText = grid is empty ? '' : header ~ "\n" ~ grid ~ "\n" ~ link %}
{% set text = grid is empty ? scoreText : gridText %}
<div class="game-share-panel" data-share-grid="{{ gridText }}" data-share-score="{{ scoreText }}">
  {% if showHeading %}
  <h4 class="h6">{{ 'game.share.heading'|trans }}</h4>
  {% endif %}
  {% if grid is not empty %}
  <div class="btn-group btn-group-sm mb-2" role="group" aria-label="{{ 'game.share.version'|trans }}">
    <button type="button" class="btn btn-outline-secondary game-share-version active" data-version="grid" aria-pressed="true">{{ 'game.share.with_grid'|trans }}</button>
    <button type="button" class="btn btn-outline-secondary game-share-version" data-version="score" aria-pressed="false">{{ 'game.share.score_only'|trans }}</button>
  </div>
  {% endif %}
  <pre class="game-share-preview">{{ text }}</pre>
  <button type="button" class="btn btn-success game-share" data-share-text="{{ text }}" title="{{ 'game.share.title'|trans }}">
    <i class="bi bi-share" aria-hidden="true"></i> {{ 'game.share.button'|trans }}
  </button>
</div>
{% endmacro %}

{# The share icon of a game in the history opens the share panel of this game in a modal #}
{% macro shareModal(game, titleKey, dexRoute, isShiny = false) %}
{% import _self as gameMacros %}
{% set modalId = 'game-share-' ~ game.id %}
<button type="button" class="btn btn-sm btn-outline-success game-share-open" data-bs-toggle="modal" data-bs-target="#{{ modalId }}" title="{{ 'game.share.title'|trans }}">
  <i class="bi bi-share" aria-hidden="true"></i>
  <span class="visually-hidden">{{ 'game.share.button'|trans }}</span>
</button>
<div class="modal fade text-center game-share-modal" id="{{ modalId }}" tabindex="-1" aria-labelledby="{{ modalId }}-title" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="{{ modalId }}-title">{{ 'game.share.heading'|trans }}</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="{{ 'game.share.close'|trans }}"></button>
      </div>
      <div class="modal-body">
        {{ gameMacros.sharePanel(game, titleKey, dexRoute, isShiny, false) }}
      </div>
    </div>
  </div>
</div>
{% endmacro %}

{% macro shareToasts() %}
<div class="toast-container position-fixed bottom-0 end-0 p-3">
  <div id="gameShareToastSuccess" class="toast text-bg-success" role="status" aria-live="polite" aria-atomic="true">
    <div class="d-flex">
      <div class="toast-body">{{ 'game.share.toast.success'|trans }}</div>
      <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button>
    </div>
  </div>
  <div id="gameShareToastError" class="toast text-bg-danger" role="alert" aria-live="assertive" aria-atomic="true">
    <div class="d-flex">
      <div class="toast-body">{{ 'game.share.toast.error'|trans }}</div>
      <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button>
    </div>
  </div>
</div>
{% endmacro %}
