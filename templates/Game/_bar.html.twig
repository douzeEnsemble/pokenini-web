{# Bar on top of a game round: title and dex on the left, round, progress, score and pause on the right #}
{% import 'ColorGame/_macros.html.twig' as colorGame %}
<header class="d-flex flex-wrap align-items-center justify-content-between gap-3 mt-3 px-4 py-3 border rounded-3 bg-body-tertiary game-bar">
  <div>
    <h1 class="h5 mb-0">{{ title|trans }}</h1>
    <h2 class="h6 fw-normal mb-0">
      <small class="text-body-secondary">{{ dexName }}</small>
      {% if isShiny %}
      <span class="badge text-bg-warning game-is-shiny"><i class="bi bi-stars"></i> {{ 'color_game.shiny'|trans }}</span>
      {% endif %}
    </h2>
  </div>
  <div class="d-flex flex-wrap align-items-center gap-3">
    <span class="text-body-secondary round-position">{{ 'color_game.round.position'|trans({'position': round.position, 'total': game.roundCount}) }}</span>
    <div class="game-bar-progress">
      {{ colorGame.progress(game, false) }}
    </div>
    <span class="badge rounded-pill bg-success-subtle text-success-emphasis fs-6 fw-semibold">{{ colorGame.score(game) }}</span>
    {% if stopPath is not null %}
    <a href="{{ stopPath }}" class="stop-game">{{ 'color_game.round.stop'|trans }}</a>
    {% endif %}
  </div>
</header>
