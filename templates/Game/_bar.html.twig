{# Bar on top of a game round: title and dex on the left, round, progress, score and pause on the right #}
{# On small screens it shrinks to two lines (title and dex, then round, progress, score and pause) so the choices fit without scrolling #}
{% import 'ColorGame/_macros.html.twig' as colorGame %}
{% set positionLabel = 'color_game.round.position'|trans({'position': round.position, 'total': game.roundCount}) %}
<header class="d-flex flex-wrap align-items-center justify-content-between gap-2 gap-md-3 mt-2 mt-md-3 px-3 py-2 px-md-4 py-md-3 border rounded-3 bg-body-tertiary game-bar">
  <div class="d-flex d-md-block flex-wrap align-items-baseline column-gap-2">
    <h1 class="h5 mb-0">{{ title|trans }}</h1>
    <h2 class="h6 fw-normal mb-0">
      <small class="text-body-secondary">{{ dexName }}</small>
      {% if isShiny %}
      <span class="badge text-bg-warning game-is-shiny"><i class="bi bi-stars"></i> {{ 'color_game.shiny'|trans }}</span>
      {% endif %}
    </h2>
  </div>
  <div class="d-flex align-items-center gap-2 gap-md-3 flex-grow-1 flex-md-grow-0">
    <span class="text-body-secondary d-none d-md-inline round-position">{{ positionLabel }}</span>
    <span class="text-body-secondary d-md-none round-position-short" title="{{ positionLabel }}">{{ round.position }}/{{ game.roundCount }}</span>
    <div class="flex-grow-1 flex-md-grow-0 game-bar-progress">
      {{ colorGame.progress(game, false) }}
    </div>
    <span class="badge rounded-pill bg-success-subtle text-success-emphasis fs-6 fw-semibold d-none d-md-inline">{{ colorGame.score(game) }}</span>
    <span class="badge rounded-pill bg-success-subtle text-success-emphasis fs-6 fw-semibold d-md-none game-score-short" title="{{ 'color_game.score'|trans({'correct': game.correctCount, 'answered': game.answeredCount}) }}">
      <i class="bi bi-check-lg" aria-hidden="true"></i> {{ game.correctCount }}/{{ game.answeredCount }}
    </span>
    {% if stopPath is not null %}
    <a href="{{ stopPath }}" class="text-nowrap stop-game" title="{{ 'color_game.round.stop'|trans }}">
      <i class="bi bi-pause-circle d-md-none fs-5" aria-hidden="true"></i>
      <span class="d-none d-md-inline">{{ 'color_game.round.stop'|trans }}</span>
      <span class="visually-hidden d-md-none">{{ 'color_game.round.stop'|trans }}</span>
    </a>
    {% endif %}
  </div>
</header>
