{% block nav %}

{% set currentRoute = app.request.attributes.get('_route') %}
{% set currentRouteParameters = app.request.attributes.get('_route_params') ?? [] %}
{% set locale = app.request.locale %}
{% set sharedTrainerId = app.request.attributes.get('t') %}

<nav class="navbar fixed-bottom navbar-expand-sm bg-light">
    <div class="container-fluid">
        {% if app.user %}
        {% set logoPath = 'app_albumdexlist_index' %}
        {% else %}
        {% set logoPath = 'app_home_index' %}
        {% endif %}
        <a
            class="navbar-brand navbar-logo"
            href="{{ path(logoPath, {'_locale': locale}) }}"
        >
            <img src="/img/logo/logo.png" alt="Logo" width="30" height="30" class="d-inline-block align-text-top" loading="lazy">
        </a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav" aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
            <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="navbarNav">
            <ul class="navbar-nav">
                <li class="nav-item trainer-link">
                    {% if is_granted("ROLE_TRAINER") %}
                    <a
                        class="nav-link {{ currentRoute == 'app_trainerindex_index' ? ' active' : '' }}"
                        {{ currentRoute == 'app_trainerindex_index' ? 'aria-current="page"' : '' }}
                        href="{{ path('app_trainerindex_index') }}"
                    >
                        <i class="bi bi-person-badge"></i>
                        {{ 'title.trainer'|trans }}
                    </a>
                    {% else %}
                    <a class="nav-link" href="{{ path('app_connect_index') }}">
                        <i class="bi bi-person"></i>
                        {{ 'nav.login'|trans }}
                    </a>
                    {% endif %}
                </li>
                <li class="nav-item election-link">
                    {% if is_granted("ROLE_TRAINER") %}
                    {% set onElection = currentRoute in ['app_electiondexlist_index', 'app_electionindex_index'] %}
                    <a
                        class="nav-link {{ onElection ? ' active' : '' }}"
                        {{ onElection ? 'aria-current="page"' : '' }}
                        href="{{ path('app_electiondexlist_index') }}"
                    >
                        <i class="bi bi-heart"></i>
                        {{ 'title.election.nav'|trans }}
                    </a>
                    {% endif %}
                </li>
                <li class="nav-item cookie-manager">
                    <button class="nav-link">
                        <i class="bi bi-cookie"></i>
                        {{ 'nav.cookie-manager'|trans }}
                    </button>
                </li>
                <li class="nav-item lang-switch">
                    {% set langTarget = locale == 'fr' ? 'en' : 'fr' %}
                    {% set routeParameters = currentRouteParameters|merge({
                        '_locale': langTarget
                    }) %}
                    {% if sharedTrainerId is defined %}
                        {% set routeParameters = routeParameters|merge({
                        't': sharedTrainerId
                    }) %}
                    {% endif %}
                    <a
                        class="nav-link"
                        href="{{ currentRoute
                            ? path(currentRoute, routeParameters)
                            : app.request.requesturi|replace({'/fr/': '/en/', '/en/': '/fr/'}) }}"
                    >
                        <i class="bi bi-translate"></i>
                        {{ ('nav.lang.'~langTarget)|trans([], 'messages', langTarget) }}
                    </a>
                </li>
                {% if is_granted("ROLE_ADMIN") %}
                {% set onAdmin = currentRoute in ['app_admin_actions', 'app_admin_reports'] %}
                <li class="nav-item admin-link">
                    <a
                        class="nav-link {{ onAdmin ? ' active' : '' }}"
                        {{ onAdmin ? 'aria-current="page"' : '' }}
                        href="{{ path('app_admin_actions') }}"
                    >
                        <i class="bi bi-wrench-adjustable-circle"></i>
                        {{ 'nav.admin'|trans }}
                    </a>
                </li>
                {% endif %}
            </ul>
        </div>
    </div>
</nav>
{% endblock nav %}
