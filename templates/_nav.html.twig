{% set currentRoute = app.request.get('_route') %}
<nav class="navbar fixed-bottom navbar-expand-sm bg-light">
    <div class="container-fluid">
        <a class="navbar-brand" href="/">Pokénini</a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav" aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
            <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="navbarNav">
            <ul class="navbar-nav">
                <li class="nav-item">
                    <a
                        class="nav-link {{ 'app_home_index' == currentRoute ? ' active' : '' }}"
                        aria-current="page"
                        href="{{ path('app_home_index') }}"
                    >
                        {{ lang is same as('fr') ? 'Accueil' : 'Home' }}
                    </a>
                </li>
                <li class="nav-item dropup lang-switch">
                    <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                        {{ lang is same as('fr') ? 'Langage' : 'Language' }}
                    </a>
                    <ul class="dropdown-menu">
                        <li><a class="dropdown-item" href="?lang=fr">Français</a></li>
                        <li><a class="dropdown-item" href="?lang=en">English</a></li>
                    </ul>
                </li>

                {% if is_granted("ROLE_ADMIN") %}
                <li class="nav-item">
                    <a
                        class="nav-link {{ 'app_admin_index' == currentRoute ? ' active' : '' }}"
                        aria-current="page"
                        href="{{ path('app_admin_index') }}"
                    >
                        {{ lang is same as('fr') ? 'Administration' : 'Administration' }}
                    </a>
                </li>
                {% endif %}
            </ul>
        </div>
        {% apply spaceless %}
        <div class="navbar-text d-none d-md-block">
            Made by and for RenaudDouze
            &nbsp;
            <a href="https://github.com/RenaudDouze">
                <i class="bi bi-github"></i>
            </a>
            &nbsp;
            <a class="navbar-text" href="https://twitter.com/RenaudDouze">
                <i class="bi bi-twitter"></i>
            </a>
        </div>
        {% endapply %}
    </div>
</nav>
