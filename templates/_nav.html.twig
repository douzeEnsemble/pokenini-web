{% block nav %}

{% set currentRoute = app.request.get('_route') %}
{% set currentRouteParameters = app.request.get('_route_params') %}
{% set locale = app.request.get('_locale') %}

<nav class="navbar fixed-top navbar-expand-sm bg-light">
    <div class="container-fluid">
        <a class="navbar-brand" href="/">
            {% block navbarTitle %}{{ block('title') }}{% endblock navbarTitle %}
        </a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav" aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
            <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="navbarNav">
            <ul class="navbar-nav">
                <li class="nav-item lang-switch">
                    {% set langTarget = locale == 'fr' ? 'en' : 'fr' %}
                    <a
                        class="nav-link"
                        href="{{ path(currentRoute, currentRouteParameters|merge({'_locale': langTarget})) }}"
                    >
                        <i class="bi bi-translate"></i>
                        {{ ('nav.lang.'~langTarget)|trans([], 'messages', langTarget) }}
                    </a>
                </li>
                {% if is_granted("ROLE_ADMIN") %}
                {% if 'album' in currentRoute  %}
                <li class="nav-item mode-switch">
                    {% set modeTarget = mode == 'write' ? 'read' : 'write' %}
                    <a
                        class="nav-link"
                        href="{{ path(currentRoute, currentRouteParameters|merge({'mode': (modeTarget == 'write' ? 'w' : 'r') })) }}"
                    >
                        <i class="bi bi-{{ modeTarget == 'write' ? 'pencil-square' : 'book' }}"></i>
                        {{ (('nav.mode.'~modeTarget))|trans }}
                    </a>
                </li>
                {% endif %}
                <li class="nav-item admin-link">
                    <a
                        class="nav-link {{ 'app_admin_index' == currentRoute ? ' active' : '' }}"
                        aria-current="page"
                        href="{{ path('app_admin_index') }}"
                    >
                        <i class="bi bi-wrench-adjustable-circle"></i>
                        {{ 'nav.admin'|trans }}
                    </a>
                </li>
                {% endif %}
            </ul>
        </div>
        {% apply spaceless %}
        <div class="navbar-text d-none d-md-block">
            {{ 'nav.madebyandfor'|trans }} RenaudDouze
            &nbsp;
            <a href="https://github.com/RenaudDouze">
                <i class="bi bi-github"></i>
            </a>
            &nbsp;
            <a class="navbar-text" href="https://twitter.com/RenaudDouze">
                <i class="bi bi-twitter"></i>
            </a>
        </div>
        {% endapply %}
    </div>
</nav>
{% endblock nav %}
