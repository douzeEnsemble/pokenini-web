{% block nav %}

{% set currentRoute = app.request.attributes.get('_route') %}
{% set currentRouteParameters = app.request.attributes.get('_route_params') ?? [] %}
{% set locale = app.request.locale %}
{% set sharedTrainerId = app.request.attributes.get('t') %}

<nav class="navbar fixed-bottom navbar-expand-sm bg-light">
    <div class="container-fluid">
        <a
            class="navbar-brand navbar-logo"
            href="{{ path('app_home_index', {'_locale': locale}) }}"
        >
            <img src="/img/logo/logo.png" alt="Logo" width="30" height="30" class="d-inline-block align-text-top" loading="lazy">
        </a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav" aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
            <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="navbarNav">
            <ul class="navbar-nav flex-grow-1">
                <li class="nav-item hub-link">
                    {% set onHub = currentRoute == 'app_home_hub' %}
                    <a
                        class="nav-link{{ onHub ? ' active' : '' }}"
                        {{ onHub ? 'aria-current="page"' : '' }}
                        href="{{ path('app_home_hub') }}"
                    >
                        <i class="bi bi-house"></i>
                        {{ 'nav.home'|trans }}
                    </a>
                </li>
                {% if is_granted("ROLE_TRAINER") %}
                <li class="nav-item album-link">
                    {% set onAlbum = currentRoute == 'app_albumdexlist_index' %}
                    <a
                        class="nav-link{{ onAlbum ? ' active' : '' }}"
                        {{ onAlbum ? 'aria-current="page"' : '' }}
                        href="{{ path('app_albumdexlist_index') }}"
                    >
                        <i class="bi bi-journal-bookmark"></i>
                        {{ 'title.album.nav'|trans }}
                    </a>
                </li>
                {% endif %}
                <li class="nav-item election-link">
                    {% if is_granted("ROLE_TRAINER") %}
                    {% set onElection = currentRoute in ['app_electiondexlist_index', 'app_electionindex_index'] %}
                    <a
                        class="nav-link {{ onElection ? ' active' : '' }}"
                        {{ onElection ? 'aria-current="page"' : '' }}
                        href="{{ path('app_electiondexlist_index') }}"
                    >
                        <i class="bi bi-heart"></i>
                        {{ 'title.election.nav'|trans }}
                    </a>
                    {% endif %}
                </li>
                <li class="nav-item game-link">
                    {% if is_granted("ROLE_TRAINER") %}
                    {% set gamePages = [
                        {'prefix': 'app_colorgame_', 'icon': 'bi-palette', 'label': 'color_game.title', 'route': 'app_colorgame_dex'},
                        {'prefix': 'app_shinygame_', 'icon': 'bi-stars', 'label': 'shiny_game.title', 'route': 'app_shinygame_dex'},
                        {'prefix': 'app_whichshinygame_', 'icon': 'bi-intersect', 'label': 'which_shiny_game.title', 'route': 'app_whichshinygame_dex'},
                    ] %}
                    {% set gameRoute = currentRoute|default('') %}
                    {% set onGame = gameRoute starts with 'app_game_' or gamePages|filter(p => gameRoute starts with p.prefix)|length > 0 %}
                    <div class="dropdown dropup d-flex align-items-center">
                        <a
                            class="nav-link {{ onGame ? ' active' : '' }}"
                            {{ onGame ? 'aria-current="page"' : '' }}
                            href="{{ path('app_game_index') }}"
                        >
                            <i class="bi bi-controller"></i>
                            {{ 'nav.game'|trans }}
                        </a>
                        <button
                            class="nav-link dropdown-toggle dropdown-toggle-split"
                            type="button"
                            data-bs-toggle="dropdown"
                            aria-expanded="false"
                        >
                            <span class="visually-hidden">{{ 'nav.toggle_submenu'|trans }}</span>
                        </button>
                        <ul class="dropdown-menu">
                            {% for page in gamePages %}
                            {% set onPage = gameRoute starts with page.prefix %}
                            <li>
                                <a
                                    class="dropdown-item{{ onPage ? ' active' : '' }}"
                                    {{ onPage ? 'aria-current="page"' : '' }}
                                    href="{{ path(page.route) }}"
                                >
                                    <i class="bi {{ page.icon }}"></i>
                                    {{ page.label|trans }}
                                </a>
                            </li>
                            {% endfor %}
                        </ul>
                    </div>
                    {% endif %}
                </li>
                <li class="nav-item trainer-link">
                    {% if is_granted("ROLE_TRAINER") %}
                    {% set trainerPages = [
                        {'key': 'customization', 'label': 'trainer.dex.title', 'route': 'app_trainerindex_index'},
                        {'key': 'links', 'label': 'trainer.links.title', 'route': 'app_trainerlinks_index'},
                        {'key': 'home_page', 'label': 'trainer.home_page.title', 'route': 'app_trainerhomepage_index'},
                        {'key': 'personnal_data', 'label': 'trainer.personnal_data.title', 'route': 'app_trainerpersonnaldata_index'},
                    ] %}
                    {% set onTrainer = currentRoute in trainerPages|map(p => p.route) %}
                    <div class="dropdown dropup d-flex align-items-center">
                        <a
                            class="nav-link {{ onTrainer ? ' active' : '' }}"
                            {{ onTrainer ? 'aria-current="page"' : '' }}
                            href="{{ path('app_trainerindex_index') }}"
                        >
                            <i class="bi bi-person-badge"></i>
                            {{ 'title.trainer'|trans }}
                        </a>
                        <button
                            class="nav-link dropdown-toggle dropdown-toggle-split"
                            type="button"
                            data-bs-toggle="dropdown"
                            aria-expanded="false"
                        >
                            <span class="visually-hidden">{{ 'nav.toggle_submenu'|trans }}</span>
                        </button>
                        <ul class="dropdown-menu">
                            {% for page in trainerPages %}
                            <li>
                                <a
                                    class="dropdown-item{{ currentRoute == page.route ? ' active' : '' }}"
                                    {{ currentRoute == page.route ? 'aria-current="page"' : '' }}
                                    href="{{ path(page.route) }}"
                                >
                                    {{ page.label|trans }}
                                </a>
                            </li>
                            {% endfor %}
                        </ul>
                    </div>
                    {% else %}
                    <a class="nav-link" href="{{ path('app_connect_index') }}">
                        <i class="bi bi-person"></i>
                        {{ 'nav.login'|trans }}
                    </a>
                    {% endif %}
                </li>
                <li class="nav-item cookie-manager">
                    <button class="nav-link">
                        <i class="bi bi-cookie"></i>
                        {{ 'nav.cookie-manager'|trans }}
                    </button>
                </li>
                <li class="nav-item lang-switch">
                    {% set langTarget = locale == 'fr' ? 'en' : 'fr' %}
                    {% set routeParameters = currentRouteParameters|merge({
                        '_locale': langTarget
                    }) %}
                    {% if sharedTrainerId is defined %}
                        {% set routeParameters = routeParameters|merge({
                        't': sharedTrainerId
                    }) %}
                    {% endif %}
                    <a
                        class="nav-link"
                        href="{{ currentRoute
                            ? path(currentRoute, routeParameters)
                            : app.request.requesturi|replace({'/fr/': '/en/', '/en/': '/fr/'}) }}"
                    >
                        <i class="bi bi-translate"></i>
                        {{ ('nav.lang.'~langTarget)|trans([], 'messages', langTarget) }}
                    </a>
                </li>
                {% if is_granted("ROLE_ADMIN") %}
                {% set adminPages = [
                    {'key': 'update_data', 'label': 'admin.actions.update_data.title', 'route': 'app_admin_update_data'},
                    {'key': 'update_availabilities', 'label': 'admin.actions.update_availabilities.title', 'route': 'app_admin_update_availabilities'},
                    {'key': 'calculate_data', 'label': 'admin.actions.calculate_data.title', 'route': 'app_admin_calculate_data'},
                    {'key': 'invalidate_data', 'label': 'admin.actions.invalidate_data.title', 'route': 'app_admin_invalidate_data'},
                    {'key': 'trigger_pipeline', 'label': 'admin.actions.trigger_pipeline.title', 'route': 'app_admin_trigger_pipeline'},
                    {'key': 'reports', 'label': 'title.admin_reports', 'route': 'app_admin_reports'},
                    {'key': 'versions', 'label': 'title.admin_versions', 'route': 'app_admin_versions'},
                ] %}
                {% set onAdmin = currentRoute in adminPages|map(p => p.route) %}
                <li class="nav-item admin-link">
                    <div class="dropdown dropup d-flex align-items-center">
                        <a
                            class="nav-link {{ onAdmin ? ' active' : '' }}"
                            {{ onAdmin ? 'aria-current="page"' : '' }}
                            href="{{ path('app_admin_update_data') }}"
                        >
                            <i class="bi bi-wrench-adjustable-circle"></i>
                            {{ 'nav.admin'|trans }}
                        </a>
                        <button
                            class="nav-link dropdown-toggle dropdown-toggle-split"
                            type="button"
                            data-bs-toggle="dropdown"
                            aria-expanded="false"
                        >
                            <span class="visually-hidden">{{ 'nav.toggle_submenu'|trans }}</span>
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end">
                            {% for page in adminPages %}
                            <li>
                                <a
                                    class="dropdown-item{{ currentRoute == page.route ? ' active' : '' }}"
                                    {{ currentRoute == page.route ? 'aria-current="page"' : '' }}
                                    href="{{ path(page.route) }}"
                                >
                                    {{ page.label|trans }}
                                </a>
                            </li>
                            {% endfor %}
                        </ul>
                    </div>
                </li>
                {% endif %}
                {% if app.user %}
                <li class="nav-item logout-link ms-auto">
                    <a
                        class="nav-link"
                        href="{{ path('app_connect_logout') }}"
                    >
                        <i class="bi bi-box-arrow-right"></i>
                        {{ 'logout'|trans }}
                    </a>
                </li>
                {% endif %}
            </ul>
        </div>
    </div>
</nav>
{% endblock nav %}
