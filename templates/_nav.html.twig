{% set currentRoute = app.request.get('_route') %}
{% set currentRouteParameters = app.request.get('_route_params') %}
{% set locale = app.request.get('_locale') %}

<nav class="navbar fixed-bottom navbar-expand-sm bg-light">
    <div class="container-fluid">
        <a class="navbar-brand" href="/">Pokénini</a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav" aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
            <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="navbarNav">
            <ul class="navbar-nav">
                <li class="nav-item">
                    <a
                        class="nav-link {{ 'app_home_index' == currentRoute ? ' active' : '' }}"
                        aria-current="page"
                        href="{{ path('app_home_index') }}"
                    >
                        {{ 'nav.home'|trans }}
                    </a>
                </li>
                <li class="nav-item dropup lang-switch">
                    <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                        {{ 'nav.switch.lang'|trans }}
                    </a>
                    <ul class="dropdown-menu">
                        <li>
                            <a
                                class="dropdown-item{{ locale == 'fr' ? ' active' : '' }}"
                                href="{{ path(currentRoute, currentRouteParameters|merge({'_locale': 'fr'})) }}"
                            >
                                {{ 'nav.lang.fr'|trans([], 'messages', 'fr') }}
                            </a>
                        </li>
                        <li>
                            <a
                                class="dropdown-item{{ locale == 'en' ? ' active' : '' }}"
                                href="{{ path(currentRoute, currentRouteParameters|merge({'_locale': 'en'})) }}"
                            >
                                {{ 'nav.lang.en'|trans([], 'messages', 'en') }}
                            </a>
                        </li>
                    </ul>
                </li>
                {% if is_granted("ROLE_ADMIN") %}
                {% if 'album' in currentRoute  %}
                <li class="nav-item dropup mode-switch">
                    <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                        {{ 'nav.switch.mode'|trans }}
                    </a>
                    <ul class="dropdown-menu">
                        <li>
                            <a class="dropdown-item" href="?mode=edit">
                                {{ 'nav.mode.edit'|trans }}
                            </a>
                        </li>
                        <li>
                            <a class="dropdown-item" href="?mode=read">
                                {{ 'nav.mode.read'|trans }}
                            </a>
                        </li>
                    </ul>
                </li>
                {% endif %}
                <li class="nav-item">
                    <a
                        class="nav-link {{ 'app_admin_index' == currentRoute ? ' active' : '' }}"
                        aria-current="page"
                        href="{{ path('app_admin_index') }}"
                    >
                        {{ 'nav.admin'|trans }}
                    </a>
                </li>
                {% endif %}
            </ul>
        </div>
        {% apply spaceless %}
        <div class="navbar-text d-none d-md-block">
            {{ 'nav.madebyandfor'|trans }} RenaudDouze
            &nbsp;
            <a href="https://github.com/RenaudDouze">
                <i class="bi bi-github"></i>
            </a>
            &nbsp;
            <a class="navbar-text" href="https://twitter.com/RenaudDouze">
                <i class="bi bi-twitter"></i>
            </a>
        </div>
        {% endapply %}
    </div>
</nav>
