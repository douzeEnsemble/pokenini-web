{% block nav %}

{% set currentRoute = app.request.get('_route') %}
{% set currentRouteParameters = app.request.get('_route_params') ?? [] %}
{% set locale = app.request.locale %}

<nav class="navbar fixed-bottom navbar-expand-sm bg-light">
    <div class="container-fluid">
        <a
            class="navbar-brand"
            href="{{ path('app_home_index', {'_locale': locale}) }}"
        >
            {% block navbarTitle %}{{ 'nav.back_home'|trans }}{% endblock navbarTitle %}
        </a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav" aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
            <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="navbarNav">
            <ul class="navbar-nav">
                {% block navbarNavPre %}{% endblock navbarNavPre %}
                <li class="nav-item lang-switch">
                    {% set langTarget = locale == 'fr' ? 'en' : 'fr' %}
                    <a
                        class="nav-link"
                        href="{{ currentRoute 
                            ? path(currentRoute, currentRouteParameters|merge({'_locale': langTarget}))
                            : app.request.requesturi|replace({'/fr/': '/en/', '/en/': '/fr/'}) }}"
                    >
                        <i class="bi bi-translate"></i>
                        {{ ('nav.lang.'~langTarget)|trans([], 'messages', langTarget) }}
                    </a>
                </li>
                {% if 'album' in currentRoute  %}
                <li class="nav-item mode-switch">
                    {% set modeTarget = attribute(constant('App\\DTO\\AlbumMode::MODES_LONG_OPPOSITE'), mode) %}
                    <a
                        class="nav-link"
                        href="{{ path(
                            currentRoute,
                            currentRouteParameters|merge({
                                'mode': attribute(constant('App\\DTO\\AlbumMode::MODES_LONG_SHORT'), modeTarget)
                            })
                        ) }}"
                    >
                        <i
                            class="bi bi-{{ modeTarget == constant('App\\DTO\\AlbumMode::LONG_MODE_WRITE')
                                ? 'pencil-square' : 'book' }}"
                        ></i>
                        {{ (('nav.mode.'~modeTarget))|trans }}
                    </a>
                </li>
                {% endif %}
                {% if is_granted("ROLE_ADMIN") %}
                <li class="nav-item admin-link">
                    <a
                        class="nav-link {{ 'app_admin_index' == currentRoute ? ' active' : '' }}"
                        aria-current="page"
                        href="{{ path('app_admin_index') }}"
                    >
                        <i class="bi bi-wrench-adjustable-circle"></i>
                        {{ 'nav.admin'|trans }}
                    </a>
                </li>
                {% endif %}
                {% block navbarNavPost %}{% endblock navbarNavPost %}
            </ul>
        </div>
        
        <ul class="navbar-nav" id="connect-navbar">
            <li class="nav-item">
                {% if is_granted("ROLE_TRAINER") %}
                <a class="nav-link" href="{{ path('app_trainer_index') }}" title="{{ 'title.trainer'|trans }}">
                    <i class="bi bi-person-badge"></i>
                </a>
                {% else %}
                <a class="nav-link" href="{{ path('app_connect_index') }}">
                    <i class="bi bi-person"></i>
                    {{ 'nav.login'|trans }}
                </a>
                {% endif %}
            </li>
        </ul>
    </div>
</nav>
{% endblock nav %}
