{% set currentRouteParameters = app.request.attributes.get('_route_params') %}
{% set locale = app.request.locale %}

{% extends 'base.html.twig' %}
{% use '_nav.html.twig' %}
{% import "AlbumDexList/_macro.html.twig" as list %}

{% block title %}Pokénini{% endblock %}

{% block stylesheets %}
  {{ parent() }}

  <link rel="stylesheet" href="{{ asset('css/album-dex-list.css') }}">
{% endblock stylesheets %}

{% block container %}
<div id="home" class="row">
  <div class="col-lg-8 mx-auto text-center">
    <h1>Pokénini</h1>

    {{ list.list(dex, locale) }}
  </div>
</div>
{% endblock %}

{% block foot_javascript %}
  {{ parent() }}
  <script>
  (function() {
    // Enable tooltips
    [...document.querySelectorAll('[data-bs-toggle="tooltip"]')]
      .map(tooltipTriggerEl => new bootstrap.Tooltip(tooltipTriggerEl));
  })();
  </script>
{% endblock foot_javascript %}
