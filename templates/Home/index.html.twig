{% extends 'base.html.twig' %}

{% block body %}
<div class="row">
    <div class="col-md-8 mx-auto text-center">
        <h1>Pokénini</h1>

        <div class="row">
            {% for dex in dexes|filter(dex => dex.isPrivate is not same as(true)) %}
            <div class="col-3 home-item">
                <a href="{{ path('app_album_index', {dexSlug: dex.slug, lang: lang}) }}">
                    {{ lang is same as('fr') ? dex.frenchName : dex.name }}
                </a>
            </div>
            {% endfor %}
        </div>
    </div>
</div>
{% endblock %}
