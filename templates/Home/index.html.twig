{% set currentRouteParameters = app.request.get('_route_params') %}
{% set locale = app.request.locale %}

{% extends 'base.html.twig' %}
{% use '_nav.html.twig' %}

{% block title %}Pokénini{% endblock %}
{% block navbarTitle %}Pokénini{% endblock navbarTitle %}

{% block container %}
<div id="home" class="row">
    <div class="col-md-8 mx-auto text-center">
        <h1>Pokénini</h1>

        <div class="row">
            {% for dex in dexes|filter(dex => dex.is_on_home is same as(true)) %}
            <div class="card col-md-3 col-6 home-item">
                <a href="{{ path('app_album_index', {'mode': constant('App\\DTO\\AlbumMode::SHORT_MODE_READ'), 'dexSlug': dex.slug}) }}">
                    <img
                        src="{{ dex_banner(dex.slug) }}"
                        class="card-img"
                        alt=""
                    >
                </a>
                <div class="card-body">
                    <h5 class="card-title">
                        <a href="{{ path('app_album_index', {'mode': constant('App\\DTO\\AlbumMode::SHORT_MODE_READ'), 'dexSlug': dex.slug}) }}">
                            {{ locale is same as('fr') ? dex.french_name : dex.name }}
                        </a>
                    </h5>
                </div>
            </div>
            {% else %}
                {% if app.user is null %}
            <div class="card col-md-3 col-6 home-item login-home-item">
                <a href="{{ path('app_connect_index') }}">
                    <img
                        src="/img/dex/banner/not_logged.png"
                        class="card-img"
                        alt=""
                    >
                </a>
                <div class="card-body">
                    <h5 class="card-title">
                        <a href="{{ path('app_connect_index') }}">
                            {{ 'login'|trans }}
                        </a>
                    </h5>
                </div>
            </div>
                {% else %}
            <div class="alert alert-info mt-5" role="alert">
                <p>{{ 'home.no_dex'|trans|replace({'<a>': '<a href="'~path('app_trainer_index')~'">'})|raw }}</p>
            </div>
                {% endif %}
            {% endfor %}
        </div>
    </div>
</div>
{% endblock %}
