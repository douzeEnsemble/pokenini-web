{% set currentRouteParameters = app.request.get('_route_params') %}
{% set locale = app.request.get('_locale') %}

{% extends 'base.html.twig' %}

{% block title %}Pokénini {{ 'title.home'|trans }}{% endblock %}

{% block body %}
<div id="home" class="row mb-5">
    <div class="col-md-8 mx-auto text-center">
        <h1>Pokénini</h1>

        <div class="row">
            {% for dex in dexes|filter(dex => dex.isPrivate is not same as(true)) %}
            <div class="card col-md-3 col-6 home-item">
                {% set bannerDir = '/img/dex/banner/' %}
                {% set dexBannerPath = bannerDir ~ dex.slug ~ '.png' %}
                {% set defaultBannerPath = bannerDir ~ 'default.png' %}
                <a href="{{ path('app_album_index', {dexSlug: dex.slug}) }}">
                    <img
                        src="{{ banner_exists(dex.slug) ? dexBannerPath : defaultBannerPath }}"
                        class="card-img"
                        alt=""
                    >
                </a>
                <div class="card-body">
                    <h5 class="card-title">
                        <a href="{{ path('app_album_index', {dexSlug: dex.slug}) }}">
                            {{ locale is same as('fr') ? dex.frenchName : dex.name }}
                        </a>
                    </h5>
                </div>
            </div>
            {% endfor %}
        </div>
    </div>
</div>
{% endblock %}
