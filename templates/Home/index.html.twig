{% set currentRouteParameters = app.request.get('_route_params') %}
{% set locale = app.request.locale %}

{% extends 'base.html.twig' %}
{% use '_nav.html.twig' %}

{% block title %}Pokénini{% endblock %}
{% block navbarTitle %}Pokénini{% endblock navbarTitle %}

{% block container %}
<div id="home" class="row">
    <div class="col-md-8 mx-auto text-center">
        <h1>Pokénini</h1>

        <div class="row">
            {% for item in dex|filter(item => item.is_on_home is same as(true)) %}
            {{ _self.homeItem(
                path('app_album_index', {'mode': constant('App\\DTO\\AlbumMode::SHORT_MODE_READ'), 'dexSlug': item.slug}),
                item.slug,
                item.name,
                item.french_name,
                locale
            ) }}
            {% else %}
                {% if app.user is null %}
                    {{ _self.homeItem(
                        path('app_connect_index'),
                        'not_logged',
                        'login'|trans,
                        'login'|trans,
                        locale
                    ) }}
                    {{ _self.homeItem(
                        '/'~locale~'/album/r/home?t=f86cbe805674d85f7806b175b70647a6a9334631',
                        'home',
                        'Home (demo)',
                        'Home (démo)',
                        locale
                    ) }}
                    {{ _self.homeItem(
                        '/'~locale~'/album/r/homeshiny?t=f86cbe805674d85f7806b175b70647a6a9334631',
                        'homeshiny',
                        'Home Shiny (demo)',
                        'Home Chromatique (démo)',
                        locale
                    ) }}
                    {{ _self.homeItem(
                        '/'~locale~'/album/r/pokemongo?t=f86cbe805674d85f7806b175b70647a6a9334631',
                        'pokemongo',
                        'Pokémon Go (demo)',
                        'Pokémon Go (démo)',
                        locale
                    ) }}
                    {{ _self.homeItem(
                        '/'~locale~'/album/r/scarletviolet?t=f86cbe805674d85f7806b175b70647a6a9334631',
                        'scarletviolet',
                        'Scarlet, Violet (demo)',
                        'Écarlate, Violet (démo)',
                        locale
                    ) }}
                {% else %}
            <div class="alert alert-info mt-5" role="alert">
                <p>{{ 'home.no_dex'|trans|replace({'<a>': '<a href="'~path('app_trainer_index')~'">'})|raw }}</p>
            </div>
                {% endif %}
            {% endfor %}
        </div>
    </div>
</div>
{% endblock %}

{% macro homeItem(url, bannerSlug, name, frenchName, locale) %}
<div class="card col-md-3 col-6 home-item">
    <a href="{{ url }}">
        <img
            src="{{ dex_banner(bannerSlug) }}"
            class="card-img"
            alt=""
        >
    </a>
    <div class="card-body">
        <h5 class="card-title">
            <a href="{{ url }}">
                {{ locale is same as('fr') ? frenchName : name }}
            </a>
        </h5>
    </div>
</div>
{% endmacro %}
