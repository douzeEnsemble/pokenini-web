{% set currentRoute = app.request.attributes.get('_route') %}
{% set currentRouteParameters = app.request.attributes.get('_route_params') ?? [] %}
{% set displayTemplateName = dex.displayTemplate is defined ? dex.displayTemplate : 'box' %}
<div id="intro">

    {# Top icons #}
    <div class="top-icons text-end">
        {# Link to box 1 or top of the list #}
        {% if 'box' == displayTemplateName %}
        <a
            class="btn btn-link btn-sm link-secondary goto goto-box1"
            href="#box-1"
            title="{{ 'album.intro.action.goto.box1'|trans }}"
            aria-label="{{ 'album.intro.action.goto.box1'|trans }}"
            data-bs-toggle="tooltip"
        >
            <i class="bi bi-box" aria-hidden="true"></i>
        </a>
        {% elseif 'list-' in displayTemplateName %}
        <a
            class="btn btn-link btn-sm link-secondary goto goto-topofthelist"
            href="#top-of-the-list"
            title="{{ 'album.intro.action.goto.top_of_the_list'|trans }}"
            aria-label="{{ 'album.intro.action.goto.top_of_the_list'|trans }}"
            data-bs-toggle="tooltip"
        >
            <i class="bi bi-list" aria-hidden="true"></i>
        </a>
        {% endif %}
    </div>

    {% set titles = dex.names|localized|split("\n") %}
    {% set title = titles.0 %}
    {% set subtitle = titles.1 is defined ? titles.1 : '' %}

    <h1 id="album-title">{{ title }}</h1>

    {% if subtitle is not empty %}
    <p id="album-subtitle" class="h2">{{ subtitle }}</p>
    {% endif %}

    <div class="list-group list-group-horizontal group-actions">
        {# Edit/Read mode link #}
        {% if allowedToEdit %}
            <button
                type="button"
                class="list-group-item list-group-item-action flex-fill list-group-item-primary album-all-catch-state-read-action"
                title="{{ (('album.intro.action.mode.read'))|trans }}"
                aria-label="{{ 'album.intro.action.mode.read'|trans }}"
                data-bs-toggle="tooltip"
                hidden
            >
                <i class="bi bi-book" aria-hidden="true"></i>
                <span class="album-action-label">{{ 'album.intro.action.short.read'|trans }}</span>
            </button>
            <button
                type="button"
                class="list-group-item list-group-item-action flex-fill list-group-item-primary album-all-catch-state-edit-action"
                title="{{ (('album.intro.action.mode.write'))|trans }}"
                aria-label="{{ 'album.intro.action.mode.write'|trans }}"
                data-bs-toggle="tooltip"
            >
                <i class="bi bi-pencil-square" aria-hidden="true"></i>
                <span class="album-action-label">{{ 'album.intro.action.short.write'|trans }}</span>
            </button>
            <button
                type="button"
                class="list-group-item list-group-item-action flex-fill list-group-item-primary album-series-action"
                title="{{ 'album.series.action'|trans }}"
                aria-label="{{ 'album.series.action'|trans }}"
                aria-pressed="false"
                data-bs-toggle="tooltip"
            >
                <i class="bi bi-lightning-charge" aria-hidden="true"></i>
                <span class="album-action-label">{{ 'album.intro.action.short.series'|trans }}</span>
            </button>
        {% endif %}

        {# Screeshot mode #}
        <button
            type="button"
            class="list-group-item list-group-item-action list-group-item-secondary flex-fill screenshot-mode screenshot-mode-off"
            title="{{ 'album.intro.action.screenshot.disable'|trans }}"
            aria-label="{{ 'album.intro.action.screenshot.disable'|trans }}"
            data-bs-toggle="tooltip"
            hidden
        >
            <i class="bi bi-camera2" aria-hidden="true"></i>
            <span class="album-action-label">{{ 'album.intro.action.short.screenshot_off'|trans }}</span>
        </button>
        <button
            type="button"
            class="list-group-item list-group-item-action list-group-item-primary flex-fill screenshot-mode screenshot-mode-on"
            title="{{ 'album.intro.action.screenshot.enable'|trans }}"
            aria-label="{{ 'album.intro.action.screenshot.enable'|trans }}"
            data-bs-toggle="tooltip"
        >
            <i class="bi bi-camera2" aria-hidden="true"></i>
            <span class="album-action-label">{{ 'album.intro.action.short.screenshot_on'|trans }}</span>
        </button>

        {# Share link #}
        {% if not dex.isPrivate %}
            <a
                class="list-group-item list-group-item-action list-group-item-success flex-fill share"
                href="{{ path('app_albumindex_index', filters|merge({ 'dexSlug': currentDexSlug, 't': trainerId, }) ) }}"
                title="{{ 'nav.share'|trans }}"
                aria-label="{{ 'nav.share'|trans }}"
                data-bs-toggle="tooltip"
            >
                <i class="bi bi-share" aria-hidden="true"></i>
                <span class="album-action-label">{{ 'album.intro.action.short.share'|trans }}</span>
            </a>
        {% endif %}

        {# Offcanvas link #}
        <a
            class="list-group-item list-group-item-action list-group-item-info flex-fill open-offcanvas"
            href="#offcanvas"
            title="{{ 'nav.open-offcanvas'|trans }}"
            aria-label="{{ 'nav.open-offcanvas'|trans }}"
            aria-controls="offcanvas"
            data-bs-title="{{ 'nav.open-offcanvas'|trans }}"
            data-bs-toggle="offcanvas"
        >
            <i class="bi bi-three-dots" aria-hidden="true"></i>
            <span class="album-action-label">{{ 'album.intro.action.short.filters'|trans }}</span>
        </a>
    </div>
</div>
