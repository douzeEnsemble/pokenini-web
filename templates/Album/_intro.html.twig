{% set locale = app.request.locale %}
{% set currentRoute = app.request.get('_route') %}
{% set currentRouteParameters = app.request.get('_route_params') ?? [] %}
{% set displayTemplateName = dex.display_template is defined ? dex.display_template : 'box' %}
<div id="intro">
  <h1 id="album-title">
      {{ locale is same as('fr') ? dex.french_name : dex.name }}
  </h1>
  <p id="album-description">
  {{ (locale is same as('fr') ? dex.french_description : dex.description)|nl2br }}
  </p>

  <div class="list-group list-group-flush">
    {# Edit/Read mode link #}
    {% if loggedTrainerId is same as(trainerId) %}
    {% set modeTarget = attribute(constant('App\\DTO\\AlbumMode::MODES_LONG_OPPOSITE'), mode) %}
    <a
      class="list-group-item list-group-item-action list-group-item-primary d-flex justify-content-between align-items-center"
      href="{{ path(
        currentRoute,
        currentRouteParameters|merge({
          'mode': attribute(constant('App\\DTO\\AlbumMode::MODES_LONG_SHORT'), modeTarget)
        })
      ) }}"
    >
      <i
        class="bi bi-{{ modeTarget == constant('App\\DTO\\AlbumMode::LONG_MODE_WRITE')
          ? 'pencil-square' : 'book' }}"
      ></i>
      {{ (('album.intro.action.mode.'~modeTarget))|trans }}
    </a>
    {% endif %}

    {# Link to box 1 or top of the list #}
    {% if 'box' == displayTemplateName %}
    <a
      class="d-lg-none list-group-item list-group-item-action list-group-item-primary d-flex justify-content-between align-items-center"
      href="#box-1"
    >
      <i
        class="bi bi-box"
      ></i>
      {{ 'album.intro.action.goto.box1'|trans }}
    </a>
    {% elseif 'list-' in displayTemplateName %}
    <a
      class="d-lg-none list-group-item list-group-item-action list-group-item-primary d-flex justify-content-between align-items-center"
      href="#top-of-the-list"
    >
      <i
        class="bi bi-list"
      ></i>
      {{ 'album.intro.action.goto.top_of_the_list'|trans }}
    </a>
    {% endif %}

    {# Is private text or share link #}
    {% if not dex.is_private %}
    <a
      class="list-group-item list-group-item-action list-group-item-success d-flex justify-content-between align-items-center"
      href="{{ path('app_album_index', {
        'mode': constant('App\\DTO\\AlbumMode::SHORT_MODE_READ'),
        'dexSlug': currentDexSlug,
        't': trainerId,
      }) }}"
    >
      <i class="bi bi-share"></i>
      {{ 'nav.share'|trans }}
    </a>
    {% else %}
    <a
      class="list-group-item disabled d-flex justify-content-between align-items-center"
      href="#"
    >
      {{ 'nav.is_private'|trans }}
      <i class="bi bi-lock"></i>
    </a>
    {% endif %}

    {# Text for another trainer #}
    {% if loggedTrainerId is not same as(trainerId) %}
    <a
      class="list-group-item disabled d-flex justify-content-between align-items-center"
      href="#"
    >
      {{ 'album.intro.label.another_trainer_album'|trans }}
      <i
        class="bi bi-person-rolodex another-trainer-album"
        title="{{ 'album.another_trainers_album'|trans }}"
      ></i>
    </a>
    {% endif %}

    {# Region name or national #}
    <a
      class="list-group-item disabled d-flex justify-content-between align-items-center"
      href="#"
    >
    {% if dex.region_name is not empty %}
      {{ 'album.intro.label.region'|trans }}
      <span class="badge bg-primary rounded-pill">{{ dex.region_name }}</span>
    {% else %}
      {{ 'album.intro.label.dex'|trans }}
      <span class="badge bg-primary rounded-pill">{{ 'album.intro.value.national'|trans }}</span>
    {% endif %}
    </a>

    {# Shiny or not #}
    <a
      class="list-group-item disabled d-flex justify-content-between align-items-center"
      href="#"
    >
      {% if dex.is_shiny %}
      {{ 'album.intro.label.is_shiny.yes'|trans }}
      <i class="bi bi-stars"></i>
      {% else %}
      {{ 'album.intro.label.is_shiny.no'|trans }}
      <i class="bi bi-bug"></i>
      {% endif %}
    </a>

    {# Template text #}
    <a
      class="list-group-item disabled d-flex justify-content-between align-items-center"
      href="#"
    >
      {{ ('album.intro.label.display_template.'~displayTemplateName)|trans }}
    </a>

    {# Version #}
    <a
      class="list-group-item disabled d-flex justify-content-between align-items-center"
      href="#"
    >  {{ 'album.intro.label.version'|trans }}
      <span class="badge text-bg-light rounded-pill">{{ dex.version }}</span>
    </a>
  </div>
</div>
