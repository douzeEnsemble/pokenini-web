{% set locale = app.request.get('_locale') %}
{% set boxLabel = locale is same as('fr') ? 'Boite' : 'Box' %}

<div class="album-container">
    <h2 class="box" id="box-1">{{ boxLabel }} 1</h2>
    <div class="row album-line">
        {% for item in list %}
        {% if (loop.index0) is not same as(0) and (loop.index0 % 6) is same as(0) %}
    </div>
    {% if (loop.index0 % 5) is same as(0) %}
        {% set boxNumber = (loop.index0 / (6*5)) + 1 %}
        <hr>
        <h2 class="box" id="box-{{ boxNumber }}">{{ boxLabel }} {{ boxNumber }}</h2>
    {% endif %}
    <div class="row album-line">
        {% endif %}
        {% set currentCatchState = item.catch_state_slug ?? 'no' %}
        <div
            class="album-case col col-2 mb-2 position-relative catch-state-{{ currentCatchState }}"
            id="{{ item.pokemon_slug }}"
        >
            <div class="text-center text-truncate">
                <label for="{{ item.pokemon_slug }}">
                    <span class="album-case-national-dex-number">
                        #{{ item.pokemon_national_dex_number }}
                    </span>
                    <span class="album-case-name">
                        {{ locale is same as('fr') ? item.pokemon_simplified_french_name : item.pokemon_simplified_name }}
                    </span>
                </label>
            </div>
            <div class="album-case-image text-center"
                 title="#{{ item.pokemon_national_dex_number }} {{ locale is same as('fr') ? item.pokemon_french_name : item.pokemon_name }}"
            >
                {{ dex.is_shiny ? _self.shinyPokemonIcon(item, locale) : _self.regularPokemonIcon(item, locale) }}
            </div>
            {% apply spaceless %}

            <div class="album-case-forms text-truncate text-end">
                {% if dex.is_display_form %}
                    {{ locale is same as('fr') ? item.pokemon_forms_french_label : item.pokemon_forms_label }}
                    {% if
                        item.pokemon_forms_french_label is empty
                        and item.pokemon_forms_label is empty
                    %}
                        &nbsp;
                    {% endif %}
                {% else %}
                    &nbsp;
                {% endif %}
            </div>
            {% endapply %}
            {% if (mode is same as('write')) %}
                <div class="album-case-action text-center mt-1">
                    <select class="catch-state-{{ currentCatchState }}" id="{{ item.pokemon_slug }}">
                        {% for catchState in catchStates %}
                            {% set isSelected = (catchState.slug is same as(currentCatchState)) %}
                            <option value="{{ catchState.slug }}" {{ isSelected ? 'selected' : '' }}>
                                {{ locale is same as('fr') ? catchState.frenchName : catchState.name }}
                            </option>
                        {% endfor %}
                    </select>
                </div>
            {% else %}
                <div class="album-case-catch-state rounded-1 ps-2">
                    {% if locale is same as('fr') %}
                        {{ item.catch_state_french_name ?? 'Non' }}
                    {% else %}
                        {{ item.catch_state_name ?? 'No' }}
                    {% endif %}
                </div>
            {% endif %}
        </div>
        {% endfor %}
    </div>
</div>

{% if (mode is same as('write')) %}
<div class="toast-container position-fixed bottom-0 mb-5 end-0 p-3">
    <div id="successToast" class="toast text-bg-success " role="alert" aria-live="assertive" aria-atomic="true">
        <div class="d-flex">
            <div class="toast-body">
                {{ 'album.update.success'|trans }}
            </div>
            <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button>
        </div>
    </div>

    <div id="errorToast" class="toast text-bg-danger" role="alert" aria-live="assertive" aria-atomic="true">
        <div class="d-flex">
            <div class="toast-body">
                {{ 'album.update.error'|trans }}
            </div>
            <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button>
        </div>
    </div>
</div>
{% endif %}

{% macro regularPokemonIcon(item, locale) %}
    {{ _self.pokemonIcon(
        item,
        'regular',
        locale
    ) }}
{% endmacro %}
{% macro shinyPokemonIcon(item, locale) %}
    {{ _self.pokemonIcon(
        item,
        'shiny',
        locale
    ) }}
{% endmacro %}
{% macro pokemonIcon(item, dir, locale) %}
    {% set iconBaseUrl = 'https://raw.githubusercontent.com/msikma/pokesprite/master/pokemon-gen8' %}
    {% set iconUrl = iconBaseUrl~'/'~dir~'/'~item.pokemon_icon~'.png' %}
    {% set pokemonName = locale is same as('fr') ? item.pokemon_french_name : item.pokemon_name %}

{#    {% if dir is same as('regular') %}#}
{#        {% set alt = locale is same as('fr') ? 'Icone de' : 'Icon of' %}#}
{#    {% else %}#}
{#        {% set alt = locale is same as('fr') ? 'Icone chromatique de' : 'Shiny icon of' %}#}
{#    {% endif %}#}

    <img
        alt="{{ ('album.icon.alt.'~dir)|trans }} {{ pokemonName }}"
        class="album-image img-fluid"
        src="{{ iconUrl }}"
    />
{% endmacro %}
