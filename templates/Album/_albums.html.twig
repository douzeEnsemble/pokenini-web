{% set boxLabel = lang is same as('fr') ? 'Boite' : 'Box' %}
<div class="album-container">
    <h2 class="box" id="box-1">{{ boxLabel }} 1</h2>
    <div class="row album-line">
        {% for item in list %}
        {% if (loop.index0) is not same as(0) and (loop.index0 % 6) is same as(0) %}
    </div>
    {% if (loop.index0 % 5) is same as(0) %}
        {% set boxNumber = (loop.index0 / (6*5)) + 1 %}
        <hr>
        <h2 class="box" id="box-{{ boxNumber }}">{{ boxLabel }} {{ boxNumber }}</h2>
    {% endif %}
    <div class="row album-line">
        {% endif %}
        {% set currentCatchState = item.catch_state_slug ?? 'no' %}
        <div
            class="album-case col col-2 mb-2 position-relative catch-state-{{ currentCatchState }}"
            id="{{ item.pokemon_slug }}"
        >
            <span class="album-case-name-hidden position-absolute text-start">
                <!-- Other language name for browser's search in page feature -->
                {{ lang is same as('fr') ? item.pokemon_name : item.pokemon_french_name }}
            </span>
            <div class="text-center text-truncate">
                <label for="{{ item.pokemon_slug }}">
                    <span class="album-case-national-dex-number">
                        #{{ item.pokemon_national_dex_number }}
                    </span>
                    <span class="album-case-name">
                        {{ lang is same as('fr') ? item.pokemon_simplified_french_name : item.pokemon_simplified_name }}
                    </span>
                </label>
            </div>
            <div class="album-case-image text-center"
                 title="#{{ item.pokemon_national_dex_number }} {{ lang is same as('fr') ? item.pokemon_french_name : item.pokemon_name }}"
            >
                {{ dex.is_shiny ? _self.shinyPokemonIcon(item, lang) : _self.regularPokemonIcon(item, lang) }}
            </div>
            {% if dex.is_display_form %}
            <div class="album-case-forms text-truncate text-end">
                {{ lang is same as('fr') ? item.pokemon_forms_french_label : item.pokemon_forms_label }}
                {% if
                    item.pokemon_forms_french_label is empty
                    and item.pokemon_forms_label is empty
                %}
                    &nbsp;
                {% endif %}
            </div>
            {% endif %}
            {% if (mode is same as('write')) %}
                <div class="album-case-action text-center mt-1">
                    <select class="catch-state-{{ currentCatchState }}" id="{{ item.pokemon_slug }}">
                        {% for catchState in catchStates %}
                            {% set isSelected = (catchState.slug is same as(currentCatchState)) %}
                            <option value="{{ catchState.slug }}" {{ isSelected ? 'selected' : '' }}>
                                {{ lang is same as('fr') ? catchState.frenchName : catchState.name }}
                            </option>
                        {% endfor %}
                    </select>
                </div>
            {% else %}
                <div class="album-case-catch-state rounded-1 ps-2">
                    {% if lang is same as('fr') %}
                        {{ item.catch_state_french_name ?? 'Non' }}
                    {% else %}
                        {{ item.catch_state_name ?? 'No' }}
                    {% endif %}
                </div>
            {% endif %}
        </div>
        {% endfor %}
    </div>
</div>

{% macro regularPokemonIcon(item, lang) %}
    {{ _self.pokemonIcon(
        item,
        'regular',
        lang
    ) }}
{% endmacro %}
{% macro shinyPokemonIcon(item, lang) %}
    {{ _self.pokemonIcon(
        item,
        'shiny',
        lang
    ) }}
{% endmacro %}
{% macro pokemonIcon(item, dir, lang) %}
    {% set iconBaseUrl = 'https://raw.githubusercontent.com/msikma/pokesprite/master/pokemon-gen8' %}
    {% set iconUrl = iconBaseUrl~'/'~dir~'/'~item.pokemon_icon~'.png' %}
    {% set pokemonName = lang is same as('fr') ? item.pokemon_french_name : item.pokemon_name %}
    {% if dir is same as('regular') %}
        {% set alt = lang is same as('fr') ? 'Icone de' : 'Icon of' %}
    {% else %}
        {% set alt = lang is same as('fr') ? 'Icone chromatique de' : 'Shiny icon of' %}
    {% endif %}
    <img
        alt="{{ alt }} {{ pokemonName }}"
        class="album-image img-fluid"
        src="{{ iconUrl }}"
    />
{% endmacro %}
