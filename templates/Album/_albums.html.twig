{% import "Album/_album_macros.html.twig" as macro %}

<div class="album-container">
    <h2 class="box" id="box-1">{{ 'title.box'|trans }} 1</h2>
    <div class="row album-line">
    {% for item in list %}
        {% if (loop.index0) is not same as(0) and (loop.index0 % 6) is same as(0) %}
    </div>
    {% if (loop.index0 % 5) is same as(0) %}
        {% set boxNumber = (loop.index0 / (6*5)) + 1 %}
        <hr>
        <h2 class="box" id="box-{{ boxNumber }}">{{ 'title.box'|trans }} {{ boxNumber }}</h2>
    {% endif %}
    <div class="row album-line">
        {% endif %}
        {{ macro.albumCase(item, dex, mode, catchStates) }}
    {% endfor %}
    </div>
</div>

{% if (mode is same as(constant('App\\DTO\\AlbumMode::LONG_MODE_WRITE'))) %}
<div class="toast-container position-fixed bottom-0 mb-5 end-0 p-3">
{% for item in list %}
    {{ macro.toasts(item) }}
{% endfor %}
</div>
{% endif %}

