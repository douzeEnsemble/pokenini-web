{% macro albumCase(item, dex, canEdit, catchStates, trainerId, list, loop) %}
  {% import "common/Pokemon/_image_macros.html.twig" as imageMacros %}

  {% set currentCatchState = item.catchStateSlug ?? 'no' %}
  {% set pokemonName = item.pokemonSimplifiedNames|localized %}

  <div class="album-case col catch-state-{{ currentCatchState }}" id="{{ item.pokemonSlug }}">
    {% set dexNumber = dex.regionName is not empty ? item.pokemonRegionalDexNumber : item.pokemonNationalDexNumber %}
    <div class="text-center">
      {# This title opens the info modal - it is not a form label for the
        catch-state select below, even though both share the same
        Pokémon. Giving it a `for` here used to make the select's
        accessible name "#150 Mewtwo" instead of describing the control,
        so the select gets its own hidden label instead (see below). #}
      <button type="button" class="album-case-title btn btn-link p-0 border-0 text-reset text-decoration-none mw-100 align-baseline" data-bs-toggle="modal" data-bs-target="#modal-{{ item.pokemonSlug }}" aria-haspopup="dialog">
        <span class="album-case-dex-number">
          #{{ dexNumber }}
        </span>
        <span class="album-case-name">
          {{ pokemonName }}
        </span>
      </button>
    </div>
    <div class="album-case-image text-center" title="#{{ dexNumber }} {{ item.pokemonNames|localized }}">
      <button type="button" class="btn btn-link p-0 border-0" data-bs-toggle="modal" data-bs-target="#modal-{{ item.pokemonSlug }}" aria-haspopup="dialog">
        {{ dex.isShiny ? imageMacros.shinyPokemonIcon(item, showCredit=false) : imageMacros.regularPokemonIcon(item, showCredit=false) }}
      </button>
    </div>
    <div class="album-case-forms text-truncate text-end">
      {% if dex.isDisplayForm %}
        {% set formsLabel = item.pokemonFormsLabels|localized %}
        {{ formsLabel }}
        {% if formsLabel is empty %}
        &nbsp;
        {% endif %}
      {% else %}
        &nbsp;
      {% endif %}
    </div>
    <div class="album-case-catch-state-container">
      {% if canEdit %}
        <div class="album-case-action text-center" hidden>
          <label class="visually-hidden" for="catch-state-{{ item.pokemonSlug }}">
            {{ 'album.catch_state.select.label'|trans({'pokemonName': pokemonName}) }}
          </label>
          <select class="catch-state-{{ currentCatchState }}" id="catch-state-{{ item.pokemonSlug }}" name="catch-state[{{ item.pokemonSlug }}]">
            {% for catchState in catchStates %}
              {% set isSelected = (catchState.slug is same as(currentCatchState)) %}
              <option value="{{ catchState.slug }}" {{ isSelected ? 'selected' : '' }}>
                {{ catchState.names|localized }}
              </option>
            {% endfor %}
          </select>
        </div>
      {% endif %}
      <div class="album-case-catch-state rounded-1 ps-2 overflow-auto">
        {% if canEdit %}
          <a href="#{{ item.pokemonSlug }}" class="album-case-catch-state-label">
          {% else %}
            <span class="album-case-catch-state-label">
            {% endif %}
            {{ item.catchStateNames is not null ? item.catchStateNames|localized : 'album.catch_state.none'|trans }}
            {% if canEdit %}
            </a>
        {% else %}
          </span>
        {% endif %}
        {% if canEdit %}
          <button type="button" id="{{ item.pokemonSlug }}-catch-state-edit-action" class="album-case-catch-state-edit-action float-end pe-1" title="{{ 'album.catch_state.edit.label'|trans({'pokemonName': pokemonName}) }}" aria-label="{{ 'album.catch_state.edit.label'|trans({'pokemonName': pokemonName}) }}">
            <i class="bi bi-pencil-square" aria-hidden="true"></i>
          </button>
        {% endif %}
      </div>
    </div>
  </div>

  <div class="modal" tabindex="-1" id="modal-{{ item.pokemonSlug }}">
    <div class="modal-dialog">
      <div class="modal-content">
        <div class="modal-header">
          {# The name in the current locale first, then the names in every other locale #}
          {% set pokemonNames = item.pokemonNames|names_by_locale %}
          <h3 class="modal-title">
            {{ pokemonNames|first }}

            {% if pokemonNames|length > 1 %}
              <span class="modal-subtitle ms-6 fs-6 d-none d-lg-inline">
                {% for otherName in pokemonNames|slice(1) %}
                  /
                  {{ otherName }}
                {% endfor %}
              </span>
            {% endif %}
          </h3>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="{{ 'a11y.close'|trans }}"></button>
        </div>
        <div class="modal-body">
          <div class="container-fluid">
            <div class="row">
              <div class="col-md-6">
                <div>
                  <span class="album-modal-image-container-regular" {{ dex.isShiny ? 'hidden': '' }}>
                    {{ imageMacros.regularPokemonImage(item) }}
                  </span>
                  <span class="album-modal-image-container-shiny" {{ dex.isShiny ? '': 'hidden' }}>
                    {{ imageMacros.shinyPokemonImage(item) }}
                  </span>
                </div>
                <div class="d-flex justify-content-evenly align-items-center text-center mt-3 mb-3">
                  <a href="#modal-{{ item.pokemonSlug }}" class="album-modal-icon album-modal-icon-regular {{ dex.isShiny ? '': 'active' }}">
                    {{ imageMacros.regularPokemonIcon(item, 'img-thumbnail') }}
                    {{ 'album.icon.title.regular'|trans }}
                  </a>
                  <a href="#modal-{{ item.pokemonSlug }}" class="album-modal-icon album-modal-icon-shiny {{ dex.isShiny ? 'active' : '' }}">
                    {{ imageMacros.shinyPokemonIcon(item, 'img-thumbnail') }}
                    {{ 'album.icon.title.shiny'|trans }}
                  </a>
                </div>
              </div>
              <div class="col-md-6">
                <ul class="list-group list-group-flush">
                  <li class="list-group-item d-flex justify-content-between align-items-center">
                    {% set simplifiedNames = item.pokemonSimplifiedNames|names_by_locale %}
                    <strong>
                      {{ simplifiedNames|first }}
                    </strong>
                    {% for otherName in simplifiedNames|slice(1) %}
                      /
                      <em>
                        {{ otherName }}
                      </em>
                    {% endfor %}
                  </li>
                  <li class="list-group-item d-flex justify-content-between align-items-center">
                    <strong>{{ 'album.modal.forms'|trans }}</strong>
                    <span>
                      {% set forms = item.pokemonFormsLabels|localized %}
                      {{ forms ? forms : 'album.modal.no_forms'|trans }}
                    </span>
                  </li>
                  <li class="list-group-item d-flex justify-content-end align-items-center">
                    <span class="album-modal-types album-modal-type-primary pokemon-type-{{ item.primaryTypeSlug }} badge">
                      {{ item.primaryTypeNames|localized }}
                    </span>

                    {% if item.secondaryTypeNames is not null %}
                      <span class="album-modal-types album-modal-type-secondary pokemon-type-{{ item.secondaryTypeSlug }} badge ms-2">
                        {{ item.secondaryTypeNames|localized }}
                      </span>
                    {% endif %}
                  </li>
                  <li class="list-group-item d-flex justify-content-between align-items-center">
                    <strong>{{ 'album.modal.national_dex_number'|trans }}</strong>
                    <span>
                      {{ item.pokemonNationalDexNumber }}
                    </span>
                  </li>
                  {% if item.pokemonRegionalDexNumber is defined and item.pokemonRegionalDexNumber %}
                    <li class="list-group-item d-flex justify-content-between align-items-center">
                      <strong>{{ 'album.modal.regional_dex_number'|trans }}</strong>
                      <span>
                        {{ item.pokemonRegionalDexNumber }}
                      </span>
                    </li>
                  {% endif %}
                </ul>
                <div
                  class="d-flex justify-content-evenly align-items-center text-center mt-2 mb-4">
                  {# If there is no previous, we use the current item as a placeholder #}
                  {% set previous = loop.first ? item : list[loop.index0 - 1] %}
                  <a href="#modal-{{ previous.pokemonSlug }}" data-bs-target="#modal-{{ previous.pokemonSlug }}" data-bs-toggle="modal" class="album-modal-icon album-modal-icon-previous {{ loop.first ? 'invisible': 'visible' }}">
                    {% if dex.isShiny %}
                      {{ imageMacros.shinyPokemonIcon(previous, 'img-thumbnaild', showCredit=false) }}
                    {% else %}
                      {{ imageMacros.regularPokemonIcon(previous, 'img-thumbnaild', showCredit=false) }}
                    {% endif %}

                    <span class="text-truncate">
                      <i class="bi bi-caret-left" aria-hidden="true"></i>
                      {{ 'album.icon.title.previous'|trans }}
                    </span>
                  </a>

                  {# If there is no next, we use the current item as a placeholder #}
                  {% set next = loop.last ? item : list[loop.index0 + 1] %}
                  <a href="#modal-{{ next.pokemonSlug }}" data-bs-target="#modal-{{ next.pokemonSlug }}" data-bs-toggle="modal" class="album-modal-icon album-modal-icon-next {{ loop.last ? 'invisible': 'visible' }}">
                    {% if dex.isShiny %}
                      {{ imageMacros.shinyPokemonIcon(next, 'img-thumbnaild', showCredit=false) }}
                    {% else %}
                      {{ imageMacros.regularPokemonIcon(next, 'img-thumbnaild', showCredit=false) }}
                    {% endif %}

                    <span class="text-truncate">
                      {{ 'album.icon.title.next'|trans }}
                      <i class="bi bi-caret-right" aria-hidden="true"></i>
                    </span>
                  </a>
                </div>
                <ul class="list-group list-group-flush">
                  <li class="list-group-item">
                    <a class="album-modal-filter-family icon-link icon-link-hover" href="{{ path('app_albumindex_index', { 'dexSlug': dex.slug, 't': trainerId, 'f': item.familyLeadSlug ?? item.pokemonSlug } ) }}">
                      {{ 'album.modal.link.family'|trans }}
                      <i class="bi bi-filter-square" aria-hidden="true"></i>
                    </a>
                  </li>
                  <li class="list-group-item">
                    <a href="https://www.pokepedia.fr/{{ item.pokemonSimplifiedNames['fr'] }}" target="_blank" rel="noopener noreferrer" class="icon-link icon-link-hover">
                      {{ 'album.modal.link.pokepedia'|trans }}
                      <span class="visually-hidden">{{ 'a11y.new_tab'|trans }}</span>
                      <i class="bi bi-box-arrow-up-right" aria-hidden="true"></i>
                    </a>
                  </li>
                  <li class="list-group-item">
                    <a href="https://bulbapedia.bulbagarden.net/wiki/{{ item.pokemonSimplifiedNames['en'] }}_(Pokémon)" target="_blank" rel="noopener noreferrer" class="icon-link icon-link-hover">
                      {{ 'album.modal.link.bulbapedia'|trans }}
                      <span class="visually-hidden">{{ 'a11y.new_tab'|trans }}</span>
                      <i class="bi bi-box-arrow-up-right" aria-hidden="true"></i>
                    </a>
                  </li>
                </ul>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
{% endmacro %}

{% macro toasts(item) %}
  {% set pokemonName = item.pokemonNames|localized %}
  <div id="successToast-{{ item.pokemonSlug }}" class="toast text-bg-success" role="alert" aria-live="assertive" aria-atomic="true">
    <div class="d-flex">
      <div class="toast-body">
        {{ 'album.update.success.prefix'|trans }}
        <strong>{{ 'album.update.success.radical'|trans({'pokemonName': pokemonName}) }}</strong>
        {{ 'album.update.success.suffix'|trans }}
      </div>
      <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="{{ 'a11y.close'|trans }}"></button>
    </div>
  </div>

  <div id="errorToast-{{ item.pokemonSlug }}" class="toast text-bg-danger" role="alert" aria-live="assertive" aria-atomic="true">
    <div class="d-flex">
      <div class="toast-body">
        {{ 'album.update.error.prefix'|trans }}
        <strong>{{ 'album.update.error.radical'|trans({'pokemonName': pokemonName}) }}</strong>
        {{ 'album.update.error.suffix'|trans }}
      </div>
      <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="{{ 'a11y.close'|trans }}"></button>
    </div>
  </div>
{% endmacro %}

{% macro shareToasts() %}
  <div id="shareToastSuccess" class="toast text-bg-light" data-bs-theme="light" role="alert" aria-live="assertive" aria-atomic="true">
    <div class="d-flex">
      <div class="toast-body">{{ 'album.share.toast.success'|trans }}</div>
      <button type="button" class="btn-close me-2 m-auto" data-bs-dismiss="toast" aria-label="{{ 'a11y.close'|trans }}"></button>
    </div>
  </div>

  <div id="shareToastError" class="toast text-bg-danger" role="alert" aria-live="assertive" aria-atomic="true">
    <div class="d-flex">
      <div class="toast-body">{{ 'album.share.toast.error'|trans }}</div>
      <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="{{ 'a11y.close'|trans }}"></button>
    </div>
  </div>
{% endmacro %}

{% macro linksToasts() %}
  <div id="linksToastSuccess" class="toast text-bg-success" role="alert" aria-live="assertive" aria-atomic="true">
    <div class="d-flex">
      <div class="toast-body">{{ 'album.offcanvas.links.toast.success'|trans }}</div>
      <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="{{ 'a11y.close'|trans }}"></button>
    </div>
  </div>

  <div id="linksToastError" class="toast text-bg-danger" role="alert" aria-live="assertive" aria-atomic="true">
    <div class="d-flex">
      <div class="toast-body">{{ 'album.offcanvas.links.toast.error'|trans }}</div>
      <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="{{ 'a11y.close'|trans }}"></button>
    </div>
  </div>
{% endmacro %}

{% macro boxTitle(boxNumber) %}
  <div class="box-title sticky-top">
    {% set title = ('title.box'|trans)~' '~boxNumber %}
    <h2 class="float-start">
      {{ title }}
    </h2>
    <a class="ms-1" href="#box-{{ boxNumber }}" title="{{ title }}" aria-label="{{ title }}">
      <i class="bi bi-link-45deg" aria-hidden="true"></i>
    </a>
    <a class="btn btn-link btn-sm link-secondary goto goto-topofthepage float-end" href="#" title="{{ 'album.intro.action.goto.top_of_the_page'|trans }}" aria-label="{{ 'album.intro.action.goto.top_of_the_page'|trans }}" data-bs-toggle="tooltip">
      <i class="bi bi-box-arrow-in-up" aria-hidden="true"></i>
    </a>
  </div>
{% endmacro %}
