{% import "Album/_album_macros.html.twig" as macro %}

<div class="album-container album-box">
{% if filter is not empty %}
    <h2 class="sticky-top">{{ 'title.empty'|trans }}</h2>
    <div class="row album-line">
        {% for item in list %}
            {{ macro.albumCase(item, dex, mode, catchStates, 2) }}
        {% endfor %}
    </div><!-- .row.album-line -->
{% else %}
    <div id="box-1" class="box row">
        <h2>{{ 'title.box'|trans }} 1</h2>
        <div class="row album-line">
            {% for item in list %}
            {% set boxNumber = (loop.index0 / (6*5)) + 1 %}

            {% if loop.index0 is not same as(0) and (loop.index0 % 6) is same as(0) %}
        </div><!-- .row.album-line -->
        <div class="row album-line">
            {% endif %}

            {% if (loop.index0) is not same as(0) and (loop.index0 % (6*5)) is same as(0) %}
        </div><!-- .row.album-line -->
    </div><!-- .bow.row -->
    <hr>
    <div id="box-{{ boxNumber }}" class="box row">
        <h2 class="sticky-top">{{ 'title.box'|trans }} {{ boxNumber }}</h2>
        <div class="row album-line">
            {% endif %}

            {{ macro.albumCase(item, dex, mode, catchStates) }}

            {% endfor %}
        </div><!-- .row.album-line -->
    </div><!-- .bow.row -->
{% endif %}
</div><!-- .album-container -->
