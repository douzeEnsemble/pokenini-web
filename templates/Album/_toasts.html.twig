{% import "Album/_album_macros.html.twig" as macro %}

{% if allowedToEdit or not dex.isPrivate %}
    <div class="toast-container position-fixed bottom-0 mb-5 end-0 p-3">
        {% if allowedToEdit %}
            {% for item in list %}
                {{ macro.toasts(item) }}
            {% endfor %}
        {% endif %}

        {% if not dex.isPrivate %}
            {{ macro.shareToasts() }}
        {% endif %}
    </div>
{% endif %}
