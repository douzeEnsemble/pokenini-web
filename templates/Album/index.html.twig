{% set locale = app.request.locale %}

{% extends 'base.html.twig' %}
{% use '_nav.html.twig' %}

{% block title %}Pokénini {{ locale is same as('fr') ? dex.frenchName : dex.name }}{% endblock title %}

{% block stylesheets %}
    {{ parent() }}

    <link rel="stylesheet" href="{{ asset('css/album.css') }}">

    <style>
    {% include 'common/_catch_state_color_tokens.html.twig' %}
    {% for catchState in catchStates %}
    .album-case.catch-state-{{ catchState.slug }} .album-case-catch-state {
        background-color: var(--catch-state-{{ catchState.slug }});
    }
    .album-case.catch-state-{{ catchState.slug }} .album-case-action {
        background-color: var(--catch-state-{{ catchState.slug }});
    }
    tr.catch-state-{{ catchState.slug }} td,
    tr.catch-state-{{ catchState.slug }} th {
        background-color: var(--catch-state-{{ catchState.slug }});
    }
    {% endfor %}

    {% include 'common/_catch_state_progress_bar_styles.html.twig' %}

    {% include 'common/_pokemon_type_color_tokens.html.twig' %}
    {% include 'common/_pokemon_type_color_classes.html.twig' %}
    </style>
{% endblock stylesheets %}

{##}

{% block container %}
<div class="row justify-content-lg-center">
    <div class="col-xxl-6">
        <div class="row justify-content-lg-center sticky-lg-top">
            <div class="co-md-4 col-lg-6">
                <div class="row">
                    {% include 'Album/_intro.html.twig' %}
                </div>
                <div class="row mt-3">
                    {% include 'Album/_report.html.twig' %}
                </div>
            </div>
        </div>
    </div>
    <div class="col-xxl-6">
        <form id="album-form" class="row justify-content-lg-center">
            {% set displayTemplateName = dex.displayTemplate is defined ? dex.displayTemplate : 'box' %}
            {% set templateData = displayTemplateName|split('-') %}
            {% set mainTemplate = templateData.0 %}
            {% set nbCaseByLine = templateData.1 is defined ? templateData.1 : 0 %}
            {% include ['Album/view/_'~(mainTemplate)~'.html.twig', 'Album/view/_box.html.twig'] with {'nbCaseByLine': nbCaseByLine} %}
        </form>

        {% include 'Album/_toasts.html.twig' %}
    </div>
    {% include 'Album/_offcanvas.html.twig' %}
</div>
{% endblock container %}

{% block head_javascripts %}
    {{ parent() }}
    <script src="{{ asset('js/album.js') }}"></script>
{% endblock head_javascripts %}

{% block foot_javascript %}
    {{ parent() }}
    <script>
    (function() {
        watchScreenshotMode();
        watchShareLink();
    })();
    </script>

    {% if allowedToEdit %}
    <script src="{{ asset('js/album-edit.js') }}"></script>
    <script src="{{ asset('js/trainer_dex.js') }}"></script>
    <script src="{{ asset('js/album-links.js') }}"></script>

    <script>
    const catchStates = JSON.parse('{{ catchStates | map(cs => {name: cs.name, frenchName: cs.frenchName, slug: cs.slug, color: cs.color}) | json_encode | raw }}');
    const locale = '{{ locale }}';
    const dex = '{{ currentDexSlug }}';
    const dexBannerUrlTemplate = '{{ dexBannerUrl }}';
    const linksLabels = {
        directionTo: '{{ 'album.offcanvas.links.direction.to'|trans }}',
        directionFrom: '{{ 'album.offcanvas.links.direction.from'|trans }}',
        directionBoth: '{{ 'album.offcanvas.links.direction.both'|trans }}',
        deleteTitle: '{{ 'album.offcanvas.links.delete_title'|trans }}',
        empty: '{{ 'album.offcanvas.links.empty'|trans|e('js') }}',
    };
    </script>

    <script>
    (function() {
        watchToggleEditMode();
        watchCatchStates();
        watchToggleShinyMode();
        watchToAdjustSelectSizes();
        watchAttributes();
        watchAlbumLinks();
    })();
    </script>
    {% endif %}
{% endblock foot_javascript %}
