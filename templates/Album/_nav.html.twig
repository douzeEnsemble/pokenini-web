<nav class="navbar fixed-bottom navbar-expand-sm bg-light">
    <div class="container-fluid">
        <a class="navbar-brand" href="/">Pokénini</a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav" aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
            <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="navbarNav">
            <ul class="navbar-nav">
                {% for dex in dexes|filter(dex => dex.isPrivate is not same as(true)) %}
                <li class="nav-item">
                    <a
                        class="nav-link {{ dex.slug is same as(currentDexSlug) ? 'active' : '' }}"
                        aria-current="page"
                        href="{{ path('app_album_index', {dexSlug: dex.slug, lang: lang}) }}"
                    >
                        {{ lang is same as('fr') ? dex.frenchName : dex.name }}
                    </a>
                </li>
                {% endfor %}
            </ul>
        </div>
    </div>
</nav>
