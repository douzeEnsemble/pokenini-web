{# Per-segment hover tooltips (below) only ever reach mouse users, and only
  one state at a time. This click-triggered popover on the whole bar - a
  legend of every state's name, percentage and count - works the same on
  touch, and needs only one interaction to see all of them instead of hunting
  for each sliver by hand. Bootstrap's Popover already defaults to a click
  trigger, so no extra data-bs-trigger is needed. #}
{% macro catchStateBar(report, locale) %}
{% set legendContent %}
<ul class="list-unstyled mb-0">
    {% for line in report.detail %}
        {% set count = line.slug is same as('no') ? report.totalUncaught : line.count %}
        {% set completion = report.total ? (100 * count / report.total)|round(2) : 0 %}
        {% set stateName = locale is same as('fr') ? line.frenchName : line.name %}
        <li class="d-flex align-items-center gap-2 mb-1">
            <span class="catch-state-dot catch-state-{{ line.slug }}"></span>
            <span>{{ stateName }} : {{ completion }}% ({{ count|number_format(0, '.', ' ') }})</span>
        </li>
    {% endfor %}
</ul>
{% endset %}
<div class="progress mb-2"
    role="button"
    tabindex="0"
    data-bs-toggle="popover"
    data-bs-html="true"
    data-bs-title="{{ 'title.report'|trans }}"
    data-bs-content="{{ legendContent|escape('html_attr') }}"
>
    {% for line in report.detail %}
        {% set count = line.slug is same as('no') ? report.totalUncaught : line.count %}
        {% set completion = report.total ? (100 * count / report.total)|round(2) : 0 %}
        {% set label = (locale is same as('fr') ? line.frenchName : line.name) ~ ': ' ~ completion ~ '%' %}
        <div class="progress-bar catch-state-{{ line.slug }}"
            role="progressbar"
            aria-label="{{ label }}"
            style="width: {{ completion }}%;"
            aria-valuenow="{{ completion }}"
            aria-valuemin="0"
            aria-valuemax="100"
            title="{{ label }}"
            data-bs-toggle="tooltip"
            data-bs-custom-class="tooltip-{{ line.slug }}"
        >
            {{ line.slug is same as('no') or line.slug is same as('yes') ? completion~'%' : '' }}
        </div>
    {% endfor %}
</div>
{% endmacro %}

{% macro roundBar(roundCount, totalRoundCount, completionUnderMaxCount, completionAtMaxCount, scopeTotalCount, baseColor) %}
{% set progress = totalRoundCount ? (100 * roundCount / totalRoundCount)|round(0) : 0 %}
{% set progressColor = baseColor %}
{% set progressColor = (0 == completionUnderMaxCount and completionAtMaxCount == scopeTotalCount) ? 'danger' : progressColor %}
{% set progressColor = (0 == completionUnderMaxCount and completionAtMaxCount == scopeTotalCount and 1 == scopeTotalCount) ? 'success' : progressColor %}
{% set progress = progressColor in ['danger', 'success'] ? 100 : progress %}
{% set progressLabel =
    ('election.stats.round.start'|trans({'n': roundCount})) ~
    roundCount ~
    ('election.stats.round.middle'|trans({'n': roundCount})) ~
    totalRoundCount ~
    ('election.stats.round.end'|trans({'n': roundCount}))
%}
{% set tooltipContent =
    ('election.stats.round.start'|trans({'n': roundCount})) ~
    '<strong>'~ roundCount ~'</strong>' ~
    ('election.stats.round.middle'|trans({'n': roundCount})) ~
    '<strong>'~ totalRoundCount ~'</strong>' ~
    ('election.stats.round.end'|trans({'n': roundCount}))
%}
{# The "{{ progress }}%" label used to live inside the colored .progress-bar
  div itself - fine at most widths, but at 0% that div is 0px wide, so its own
  text is trapped inside a zero-width box and never paints. A dex with no
  rounds voted yet then shows a bare empty grey track with no label at all,
  indistinguishable from "still loading" or broken. Moving the label to a
  sibling overlay centered on the outer .progress track (not the inner,
  width-constrained bar) keeps it visible at any completion, including 0%. #}
<div class="progress mb-3 position-relative" role="progressbar" aria-label="{{ progressLabel }}" aria-valuenow="{{ progress }}" aria-valuemin="0" aria-valuemax="100">
    <div class="progress-bar progress-bar-striped bg-{{ progressColor }}" style="width: {{ progress }}%" data-bs-toggle="tooltip" data-bs-html="true" data-bs-title="{{ tooltipContent }}"></div>
    <span class="round-bar-label position-absolute top-50 start-50 translate-middle small fw-semibold">{{ progress }}%</span>
</div>
{% endmacro %}
